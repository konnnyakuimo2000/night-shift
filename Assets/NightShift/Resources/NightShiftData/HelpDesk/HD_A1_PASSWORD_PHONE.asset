  subject: "\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u6559\u3048\u3066\u307B\u3057\u3044\u3068\u8A00\u308F\u308C\u305F"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u3055\u304D\u307B\u3069\u300C\u672C\u793E\u306E\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u306E\u8005\u300D\u3068\u540D\u4E57\u308B\u4EBA\u304B\u3089\u96FB\u8A71\u304C\u3042\u308A\u3001\u7DCA\u6025\u306E\u30E1\u30F3\u30C6\u30CA\u30F3\u30B9\u306A\u306E\u3067\u79C1\u306E\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u6559\u3048\u3066\u307B\u3057\u3044\u3068\u8A00\u308F\u308C\u307E\u3057\u305F\u3002\n\u6298\u308A\u8FD4\u3059\u3068\u8A00\u3063\u3066\u4E00\u5EA6\u5207\u3063\u305F\u306E\u3067\u3059\u304C\u3001\u6559\u3048\u3066\u3082\u5927\u4E08\u592B\u3067\u3057\u3087\u3046\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u30D1\u30B9\u30EF\u30FC\u30C9\u306F\u8AB0\u306B\u3082\u6559\u3048\u306A\u3044\u3088\u3046\u4F1D\u3048\u3001\u96FB\u8A71\u306E\u5185\u5BB9\u3092\u8A18\u9332\u3057\u3066\u5831\u544A\u3057\u3066\u3082\u3089\u3046\u3002"
  incorrectOption: "\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u306E\u62C5\u5F53\u8005\u306A\u3089\u554F\u984C\u306A\u3044\u306E\u3067\u3001\u6298\u308A\u8FD4\u3057\u3066\u4F1D\u3048\u3066\u3088\u3044\u3068\u56DE\u7B54\u3059\u308B\u3002"
  replyAfterAnswer: "\u308F\u304B\u308A\u307E\u3057\u305F\u3002\u305D\u306E\u3088\u3046\u306B\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u793E\u54E1\u3084\u95A2\u4FC2\u8005\u3092\u88C5\u3063\u3066\u96FB\u8A71\u3067\u30D1\u30B9\u30EF\u30FC\u30C9\u306A\u3069\u3092\u805E\u304D\u51FA\u3059\u624B\u53E3\u306F\u300C\u30BD\u30FC\u30B7\u30E3\u30EB\u30A8\u30F3\u30B8\u30CB\u30A2\u30EA\u30F3\u30B0\u300D\u306E\u5178\u578B\u4F8B\u3002\u76F8\u624B\u304C\u8AB0\u3067\u3042\u3063\u3066\u3082\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u306F\u6559\u3048\u306A\u3044\u3002"
  sourceNote: "\u5E73\u621028\u5E74\u5EA6 \u6625\u671F IT\u30D1\u30B9\u30DD\u30FC\u30C8\u8A66\u9A13
