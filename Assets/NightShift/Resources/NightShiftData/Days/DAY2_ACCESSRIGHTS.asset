  title: ACCESS RIGHTS
  dateLabel: "1998/05/21 (\u6728)"
  clockInDateLabel: "1998/05/20 (\u6C34)"
  startMinute: 0
  endMinute: 240
  realSecondsPerGameMinute: 1.75
  endWarningMinute: 230
  graceRealSeconds: 20
  briefingFrom: "\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8 \u8AB2\u9577 \u68EE\u7530"
  briefingBody: "\u6628\u591C\u306F\u304A\u75B2\u308C\u3055\u307E\u3067\u3057\u305F\u3002\n\u672C\u65E5\u304B\u3089
    <color=#0030A0><b>IT\u30B5\u30DD\u30FC\u30C8\u53D7\u4ED8\u7BA1\u7406</b></color>\uFF08\u793E\u54E1\u304B\u3089\u306E\u76F8\u8AC7\u30FB\u30EA\u30E2\u30FC\u30C8\u30B5\u30DD\u30FC\u30C8\uFF09\u3082\u62C5\u5F53\u3057\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3002\n\n\u25A0
    \u672C\u65E5\u306E\u696D\u52D9\n\u30FB<b>\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB</b>\n\u30FB\u793E\u54E1\u304B\u3089\u306E<b>IT\u554F\u3044\u5408\u308F\u305B</b>\u3078\u306E\u5BFE\u5FDC\uFF08\u76F8\u8AC7\u3078\u306E\u56DE\u7B54\uFF0F\u30EA\u30E2\u30FC\u30C8\u30B5\u30DD\u30FC\u30C8\uFF09\n\n\u25A0
    \u63A5\u7D9A\u5BE9\u67FB\u306E\u30EB\u30FC\u30EB"
  rules:
  - "<b>\u793E\u54E1</b>\u304C<b>\u81EA\u5206\u306E\u767B\u9332\u7AEF\u672B</b>\u304B\u3089\u63A5\u7D9A\u3059\u308B\u5834\u5408\u306F
    <color=#0030A0><b>\u8A31\u53EF</b></color> \u3059\u308B\u3002"
  - "<b>\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u306A\u3044\u5229\u7528\u8005</b>\u3001\u307E\u305F\u306F
    <b>\u305D\u306E\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B\u3067\u306F\u306A\u3044\u7AEF\u672B</b>
    \u304B\u3089\u306E\u63A5\u7D9A\u306F <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "\u63A5\u7D9A\u5148\u306E\u30B7\u30B9\u30C6\u30E0\u3092\u4F7F\u3046\u306B\u306F
    <b>\u6A29\u9650</b> \u304C\u5FC5\u8981\u3002\u793E\u54E1\u60C5\u5831\u3067 <color=#8A4B00><b>\u63A5\u7D9A\u7A2E\u5225\u306B\u5FC5\u8981\u306A\u6A29\u9650</b></color>
    \u3092\u78BA\u8A8D\u3057\u3001\xD7 \u306A\u3089 <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  newRuleStartIndex: 2
  briefingFooter: "\u63A5\u7D9A\u7A2E\u5225\u3054\u3068\u306B\u5FC5\u8981\u306A\u6A29\u9650\u306F\u3001\u6DFB\u4ED8\u306E
    <color=#8A4B00><b>\u300C\u793E\u5185\u30B5\u30FC\u30D0\u30FC\u69CB\u6210\u8CC7\u6599\u300D</b></color>
    \u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\n\u30EA\u30E2\u30FC\u30C8\u30B5\u30DD\u30FC\u30C8\u306E\u624B\u9806\u306F
    <color=#8A4B00><b>\u300C\u30C8\u30E9\u30D6\u30EB\u5BFE\u5FDC\u30DE\u30CB\u30E5\u30A2\u30EB\u300D</b></color>
    \u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n<b>\u793E\u54E1\u672C\u4EBA\u3067\u3001\u672C\u4EBA\u306E\u7AEF\u672B\u3067\u3082\u3001\u6A29\u9650\u304C\u306A\u3051\u308C\u3070\u62D2\u5426\u3067\u3059\u3002</b>\n\n\u203B
    \u64CD\u4F5C\u65B9\u6CD5\u306A\u3069\u306F\u6DFB\u4ED8\u306E\u30DE\u30CB\u30E5\u30A2\u30EB\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u3053\u306E\u696D\u52D9\u9023\u7D61\u306F\u3001\u30BF\u30B9\u30AF\u30D0\u30FC\u306E
    [\u696D\u52D9\u9023\u7D61] \u304B\u3089\u3044\u3064\u3067\u3082\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
