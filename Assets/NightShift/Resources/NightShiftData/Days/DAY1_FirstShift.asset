  briefingFrom: "\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8 \u8AB2\u9577 \u68EE\u7530"
  briefingBody: "\u591C\u9593IT\u62C5\u5F53\u3068\u3057\u3066\u3001\u4ECA\u591C\u304B\u3089\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3057\u307E\u3059\u3002\n\u696D\u52D9\u6642\u9593\u306F
    <b>00:00\u301C04:00</b> \u3067\u3059\u3002<b>\u6642\u9593\u306F\u6B62\u307E\u308A\u307E\u305B\u3093</b>\uFF08Esc
    \u3067\u4E00\u6642\u505C\u6B62\u3067\u304D\u307E\u3059\uFF09\u3002\n\n\u25A0
    \u672C\u65E5\u306E\u696D\u52D9\n\u30FB<b>\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB</b>\uFF08\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A\u76E3\u8996\uFF09\n\u3000\u793E\u5185\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u3078\u306E\u63A5\u7D9A\u8981\u6C42\u3092\u3001\u793E\u54E1\u60C5\u5831\u3068\u7167\u3089\u3057\u5408\u308F\u305B\u3066\u8A31\u53EF\u30FB\u62D2\u5426\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\n\u25A0
    \u63A5\u7D9A\u5BE9\u67FB\u306E\u30EB\u30FC\u30EB"
  rules:
  - "<b>\u793E\u54E1</b>\u304C<b>\u81EA\u5206\u306E\u767B\u9332\u7AEF\u672B</b>\u304B\u3089\u63A5\u7D9A\u3059\u308B\u5834\u5408\u306F
    <color=#0030A0><b>\u8A31\u53EF</b></color> \u3059\u308B\u3002"
  - "<b>\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u306A\u3044\u5229\u7528\u8005</b>\u3001\u307E\u305F\u306F
    <b>\u305D\u306E\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B\u3067\u306F\u306A\u3044\u7AEF\u672B</b>
    \u304B\u3089\u306E\u63A5\u7D9A\u306F <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  newRuleStartIndex: -1
  briefingFooter: "\u5229\u7528\u8005\u3068\u7AEF\u672B\u306F <color=#8A4B00><b>\u300C\u793E\u54E1\u60C5\u5831\u306E\u691C\u7D22\u30FB\u53C2\u7167\u300D</b></color>
    \u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\n\u672C\u65E5\u4F7F\u3046\u306E\u306F\u300C\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A\u76E3\u8996\u300D\u3068\u300C\u793E\u54E1\u60C5\u5831\u306E\u691C\u7D22\u30FB\u53C2\u7167\u300D\u3060\u3051\u3067\u3059\u3002\u307B\u304B\u306E\u30B7\u30B9\u30C6\u30E0\u306F\u3001\u6163\u308C\u3066\u304D\u305F\u3089\u9806\u306B\u62C5\u5F53\u3057\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3002\n<b>\u8FF7\u3063\u305F\u3089\u3001\u307E\u305A\u8ABF\u3079\u308B\u3053\u3068\u3002</b>\n\n\u203B
    \u64CD\u4F5C\u65B9\u6CD5\u306A\u3069\u306F\u6DFB\u4ED8\u306E\u30DE\u30CB\u30E5\u30A2\u30EB\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u3053\u306E\u696D\u52D9\u9023\u7D61\u306F\u3001\u30BF\u30B9\u30AF\u30D0\u30FC\u306E
    [\u696D\u52D9\u9023\u7D61] \u304B\u3089\u3044\u3064\u3067\u3082\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
