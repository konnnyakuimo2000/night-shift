  dayNumber: 3
  title: OUTSIDE THE WALL
  dateLabel: "1998/05/22 (\u91D1)"
  clockInDateLabel: "1998/05/21 (\u6728)"
  startMinute: 0
  endMinute: 240
  realSecondsPerGameMinute: 2
  endWarningMinute: 230
  graceRealSeconds: 20
  briefingFrom: "\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8 \u8AB2\u9577 \u68EE\u7530"
  briefingBody: "\u672C\u65E5\u304B\u3089 <color=#0030A0><b>\u30B7\u30B9\u30C6\u30E0\u30ED\u30B0</b></color>\u30FB<color=#0030A0><b>\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u30DE\u30C3\u30D7</b></color>\u30FB<color=#0030A0><b>\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u60C5\u5831</b></color>
    \u3082\u5229\u7528\u3067\u304D\u307E\u3059\u3002\n<b>\u793E\u5916\u304B\u3089\u306E\u63A5\u7D9A</b>\u3084\u3001<b>\u4E0D\u5BE9\u306A\u901A\u4FE1</b>\u306B\u3082\u6CE8\u610F\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\n\u25A0
    \u672C\u65E5\u306E\u696D\u52D9\n\u30FB<b>\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB</b>\n\u30FB<b>IT\u554F\u3044\u5408\u308F\u305B</b>\u3078\u306E\u5BFE\u5FDC\n\u30FB<b>\u30B7\u30B9\u30C6\u30E0\u30ED\u30B0\u30FB\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u306E\u76E3\u8996</b>\n\n\u25A0
    \u63A5\u7D9A\u5BE9\u67FB\u306E\u30EB\u30FC\u30EB"
  rules:
  - "<b>\u793E\u54E1</b>\u304C<b>\u81EA\u5206\u306E\u767B\u9332\u7AEF\u672B</b>\u304B\u3089\u63A5\u7D9A\u3059\u308B\u5834\u5408\u306F
    <color=#0030A0><b>\u8A31\u53EF</b></color> \u3059\u308B\u3002"
  - "<b>\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u306A\u3044\u5229\u7528\u8005</b>\u3001\u307E\u305F\u306F
    <b>\u305D\u306E\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B\u3067\u306F\u306A\u3044\u7AEF\u672B</b>
    \u304B\u3089\u306E\u63A5\u7D9A\u306F <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "\u63A5\u7D9A\u5148\u306E\u30B7\u30B9\u30C6\u30E0\u3092\u4F7F\u3046\u306B\u306F
    <b>\u6A29\u9650</b> \u304C\u5FC5\u8981\u3002\u793E\u54E1\u60C5\u5831\u3067 <color=#8A4B00><b>\u63A5\u7D9A\u7A2E\u5225\u306B\u5FC5\u8981\u306A\u6A29\u9650</b></color>
    \u3092\u78BA\u8A8D\u3057\u3001\xD7 \u306A\u3089 <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "<b>\u793E\u5916</b>\u304B\u3089<b>\u7BA1\u7406\u7CFB\u30B7\u30B9\u30C6\u30E0</b>\uFF08ADMIN-SRV01
    \u7B49\uFF09\u3078\u306E\u63A5\u7D9A\u306F <color=#B00000><b>\u7981\u6B62</b></color>\u3002"
  - "\u793E\u5916\u304B\u3089\u306E\u63A5\u7D9A (VPN) \u306F\u3001<color=#8A4B00><b>VPN\u5229\u7528\u3092\u8A31\u53EF\u3055\u308C\u305F\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B</b></color>
    \u306B\u9650\u308B\u3002"
  newRuleStartIndex: 3
  briefingFooter: "\u4E0D\u5BE9\u306A\u8981\u6C42\u304C\u3042\u3063\u305F\u3089\u3001<color=#8A4B00><b>\u30B7\u30B9\u30C6\u30E0\u30ED\u30B0</b></color>
    \u3067\u540C\u3058\u63A5\u7D9A\u5143\u306E\u8A18\u9332\u304C\u306A\u3044\u304B\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30B5\u30FC\u30D0\u30FC\u904B\u7528\u7BA1\u7406\u306F\u6765\u9031\u304B\u3089\u62C5\u5F53\u7BC4\u56F2\u306B\u52A0\u308F\u308B\u4E88\u5B9A\u3067\u3059\u3002\n<b>\u8FF7\u3063\u305F\u3089\u3001\u307E\u305A\u8ABF\u3079\u308B\u3053\u3068\u3002</b>\n\n\u203B
    \u64CD\u4F5C\u65B9\u6CD5\u306A\u3069\u306F\u6DFB\u4ED8\u306E\u30DE\u30CB\u30E5\u30A2\u30EB\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u3053\u306E\u696D\u52D9\u9023\u7D61\u306F\u3001\u30BF\u30B9\u30AF\u30D0\u30FC\u306E
    [\u696D\u52D9\u9023\u7D61] \u304B\u3089\u3044\u3064\u3067\u3082\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
