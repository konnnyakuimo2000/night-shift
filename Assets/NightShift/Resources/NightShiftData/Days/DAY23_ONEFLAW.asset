  m_Name: DAY23_ONEFLAW
  m_EditorClassIdentifier: 
  dayNumber: 23
  title: ONE FLAW
  dateLabel: "1998/06/17 (\u6C34)"
  clockInDateLabel: "1998/06/16 (\u706B)"
  startMinute: 0
  endMinute: 360
  realSecondsPerGameMinute: 1.8
  endWarningMinute: 350
  graceRealSeconds: 25
  requestsExpire: 1
  briefingFrom: "\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8 \u8AB2\u9577 \u68EE\u7530"
  briefingBody: "\u672C\u7269\u305D\u3063\u304F\u308A\u306E\u8981\u6C42\u3067\u3001<b>\u5408\u308F\u306A\u3044\u9805\u76EE\u304C1\u3064\u3060\u3051</b>
    \u306E\u3082\u306E\u304C\u5897\u3048\u3066\u3044\u307E\u3059\u3002\n\n\u25A0
    \u672C\u65E5\u306E\u696D\u52D9\n\u30FB<b>\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB</b>\u3000\u30FB<b>IT\u554F\u3044\u5408\u308F\u305B</b>\u3078\u306E\u5BFE\u5FDC\u3000\u30FB<b>\u30ED\u30B0\u30FB\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u306E\u76E3\u8996</b>\n\n\u25A0
    \u63A5\u7D9A\u5BE9\u67FB\u306E\u30EB\u30FC\u30EB"
  rules:
  - "<b>\u793E\u54E1</b>\u304C<b>\u81EA\u5206\u306E\u767B\u9332\u7AEF\u672B</b>\u304B\u3089\u63A5\u7D9A\u3059\u308B\u5834\u5408\u306F
    <color=#0030A0><b>\u8A31\u53EF</b></color> \u3059\u308B\u3002"
  - "<b>\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u306A\u3044\u5229\u7528\u8005</b>\u304B\u3089\u306E\u63A5\u7D9A\u306F
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002\uFF08\u793E\u54E1\u756A\u53F7\u30FB\u6C0F\u540D\u3067\u691C\u7D22\u3057\u3066\u78BA\u8A8D\uFF09"
  - "<b>\u305D\u306E\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B\u3067\u306F\u306A\u3044\u7AEF\u672B</b>\u304B\u3089\u306E\u63A5\u7D9A\u306F\u3001\u793E\u54E1\u672C\u4EBA\u3067\u3082
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "\u63A5\u7D9A\u8981\u6C42\u306E <color=#8A4B00><b>\u300C\u5FC5\u8981\u306A\u6A29\u9650\u300D</b></color>
    \u304C\u3001\u793E\u54E1\u60C5\u5831\u306E\u6A29\u9650\u6B04\u3067 \xD7 \u306A\u3089
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "\u63A5\u7D9A\u5143\u304C <b>\u793E\u5916</b> \u306E\u5834\u5408\u306F <color=#8A4B00><b>\u300CVPN\u63A5\u7D9A\u300D\u3060\u3051</b></color>\u3002\u793E\u54E1\u306E
    <b>VPN\u5229\u7528\u304C\u300C\u8A31\u53EF\u300D</b> \u3067\u3001<b>VPN\u7AEF\u672B</b>
    \u304B\u3089\u306A\u3089 <color=#0030A0><b>\u8A31\u53EF</b></color>\u3002\u305D\u308C\u4EE5\u5916\u306F
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "<b>\u793E\u5185\u306E\u767B\u9332\u7AEF\u672B</b>\u304B\u3089\u306E\u63A5\u7D9A\u306F\u3001\u63A5\u7D9A\u5143\u306E
    <color=#8A4B00><b>IP\u30A2\u30C9\u30EC\u30B9</b></color> \u304C\u793E\u54E1\u60C5\u5831\u306E
    <b>\u300C\u7AEF\u672BIP\u300D</b> \u3068\u540C\u3058\u304B\u78BA\u8A8D\u3059\u308B\u3002<color=#B00000><b>\u9055\u3048\u3070\u62D2\u5426</b></color>\uFF08\u306A\u308A\u3059\u307E\u3057\uFF09\u3002"
  - "<b>\u52E4\u52D9\u72B6\u614B\u304C\u300C\u9000\u52E4\u300D</b>\u306E\u793E\u54E1\u304B\u3089\u306E\u63A5\u7D9A\u306F
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "<b>\u5728\u7C4D\u72B6\u614B\u304C\u300C\u5728\u7C4D\u300D\u3067\u306A\u3044</b>\u793E\u54E1\uFF08\u4F11\u8077\u30FB\u9000\u8077\uFF09\u304B\u3089\u306E\u63A5\u7D9A\u306F
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  - "\u5229\u7528\u8005\u304C <b>\u81EA\u5206\uFF08\u904B\u7528\u62C5\u5F53\u8005\uFF09\u306EID</b>
    \u306E\u8981\u6C42\u306F <color=#B00000><b>\u62D2\u5426</b></color> \u3057\u3001\u3059\u3050\u306B\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5909\u66F4\u3059\u308B\u3002"
  newRuleStartIndex: -1
  changedRuleIndices: 
  briefingFooter: "\u7AEF\u672B\u30FBIP\u30FB\u52E4\u52D9\u72B6\u614B\u30FB\u5728\u7C4D\u72B6\u614B\u3002\u5168\u90E8\u78BA\u304B\u3081\u308B\u7FD2\u6163\u3092\u3002\n\u203B
    \u64CD\u4F5C\u65B9\u6CD5\u306F\u6DFB\u4ED8\u306E\u30DE\u30CB\u30E5\u30A2\u30EB\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
