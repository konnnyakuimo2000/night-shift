  briefingFrom: "\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8 \u8AB2\u9577 \u68EE\u7530"
  briefingBody: "\u6628\u591C\u306F\u304A\u75B2\u308C\u3055\u307E\u3067\u3057\u305F\u3002\n\u672C\u65E5\u304B\u3089
    <color=#0030A0><b>\u7AEF\u672B\u306E\u78BA\u8A8D</b></color> \u3068 <color=#0030A0><b>\u793E\u54E1\u60C5\u5831\u306E\u8A73\u7D30\u8868\u793A</b></color>\uFF08\u9854\u5199\u771F\u306A\u3069\uFF09\u304C\u4F7F\u3048\u307E\u3059\u3002\n\u63A5\u7D9A\u8981\u6C42\u306E
    <b>\u7AEF\u672B</b> \u3068\u3001\u793E\u54E1\u60C5\u5831\u306E <b>\u767B\u9332\u7AEF\u672B</b>
    \u304C\u8868\u793A\u3055\u308C\u308B\u3088\u3046\u306B\u306A\u308A\u307E\u3059\u3002\n\u307E\u305F\u3001<b>\u30ED\u30B0\u30A4\u30F3\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u307E\u3060\u521D\u671F\u8A2D\u5B9A\u306E\u307E\u307E</b>\u3067\u3059\u3002\u672C\u65E5\u4E2D\u306B\u5909\u66F4\u3092\u304A\u9858\u3044\u3057\u307E\u3059\u3002\n\n\u25A0
    \u672C\u65E5\u306E\u696D\u52D9\n\u30FB<b>\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB</b>
    \u2026 \u5229\u7528\u8005\u3060\u3051\u3067\u306A\u304F\u3001<b>\u63A5\u7D9A\u3057\u3066\u304D\u305F\u7AEF\u672B</b>\u3082\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30FB<b>\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u5909\u66F4</b>
    \u2026 [\u30B7\u30B9\u30C6\u30E0\u8A2D\u5B9A] \u2192 [\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u5909\u66F4]\n\n\u25A0
    \u63A5\u7D9A\u5BE9\u67FB\u306E\u30EB\u30FC\u30EB"
  rules:
  - "<b>\u793E\u54E1</b>\u304C<b>\u81EA\u5206\u306E\u767B\u9332\u7AEF\u672B</b>\u304B\u3089\u63A5\u7D9A\u3059\u308B\u5834\u5408\u306F
    <color=#0030A0><b>\u8A31\u53EF</b></color> \u3059\u308B\u3002"
  - "<b>\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u306A\u3044\u5229\u7528\u8005</b>\u304B\u3089\u306E\u63A5\u7D9A\u306F
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002\uFF08\u793E\u54E1\u756A\u53F7\u30FB\u6C0F\u540D\u3067\u691C\u7D22\u3057\u3066\u78BA\u8A8D\uFF09"
  - "<b>\u305D\u306E\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B\u3067\u306F\u306A\u3044\u7AEF\u672B</b>\u304B\u3089\u306E\u63A5\u7D9A\u306F\u3001\u793E\u54E1\u672C\u4EBA\u3067\u3082
    <color=#B00000><b>\u62D2\u5426</b></color>\u3002"
  newRuleStartIndex: 2
  changedRuleIndices: 00000000
  briefingFooter: "\u793E\u54E1\u306E\u767B\u9332\u7AEF\u672B\u306F\u3001<color=#8A4B00><b>\u300C\u793E\u54E1\u60C5\u5831\u306E\u691C\u7D22\u30FB\u53C2\u7167\u300D</b></color>
    \u306E\u691C\u7D22\u7D50\u679C\u3084\u8A73\u7D30\u8868\u793A\u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\n\u30EB\u30FC\u30EB1\u306F\u3001\u672C\u65E5\u304B\u3089
    <b>\u300C\u81EA\u5206\u306E\u767B\u9332\u7AEF\u672B\u304B\u3089\u300D</b> \u306E\u6761\u4EF6\u304C\u52A0\u308F\u308A\u307E\u3057\u305F\u3002\n<b>\u793E\u54E1\u672C\u4EBA\u3067\u3082\u3001\u4ED6\u4EBA\u306E\u7AEF\u672B\u3084\u79C1\u7269\u306E\u7AEF\u672B\u304B\u3089\u306E\u63A5\u7D9A\u306F\u8A8D\u3081\u3089\u308C\u307E\u305B\u3093\u3002</b>\n\n\u203B
    \u64CD\u4F5C\u65B9\u6CD5\u306A\u3069\u306F\u6DFB\u4ED8\u306E\u30DE\u30CB\u30E5\u30A2\u30EB\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u3053\u306E\u696D\u52D9\u9023\u7D61\u306F\u3001\u30BF\u30B9\u30AF\u30D0\u30FC\u306E
    [\u30E1\u30FC\u30EB] \u306E\u53D7\u4FE1\u30C8\u30EC\u30A4\u304B\u3089\u3044\u3064\u3067\u3082\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
