  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a728b0253e65334ca61413bf0408212, type: 3}
  m_Name: DOC_TROUBLE_MANUAL
  m_EditorClassIdentifier: 
  documentId: TROUBLE_MANUAL
  title: "PC\u30C8\u30E9\u30D6\u30EB\u5BFE\u5FDC\u30DE\u30CB\u30E5\u30A2\u30EB\uFF08\u30EA\u30E2\u30FC\u30C8\u30B5\u30DD\u30FC\u30C8\uFF09"
  fileName: "\u30C8\u30E9\u30D6\u30EB\u5BFE\u5FDC\u30DE\u30CB\u30E5\u30A2\u30EB.doc"
  icon: helpdesk
  requiredFeature: REMOTE_SUPPORT
  body: "\u793E\u54E1PC\u306E\u4E0D\u5177\u5408\u306B\u30EA\u30E2\u30FC\u30C8\u3067\u5BFE\u5FDC\u3059\u308B\u305F\u3081\u306E\u624B\u9806\u3067\u3059\u3002"
  sections:
  - requiredFeature: 
    text: "<b>\u25A0 \u57FA\u672C\u306E\u6D41\u308C</b>\n{FIG:REMOTE_FLOW}\n1. <b>\u75C7\u72B6\u3092\u78BA\u8A8D</b>
      \u2026 \u793E\u54E1\u304B\u3089\u306E\u554F\u3044\u5408\u308F\u305B\u5185\u5BB9\u3092\u8AAD\u307F\u3001\u4F55\u304C\u3067\u304D\u306A\u3044\u306E\u304B\u3092\u628A\u63E1\u3059\u308B\u3002\n2.
      <b>\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A</b> \u2026 \u53D7\u4ED8\u7BA1\u7406\u304B\u3089\u793E\u54E1PC\u306B\u63A5\u7D9A\u3059\u308B\u3002\n3.
      <b>\u539F\u56E0\u3092\u8ABF\u3079\u308B</b> \u2026 \u8A2D\u5B9A\u753B\u9762\u30FB\u901A\u77E5\u9818\u57DF\u306E\u30A2\u30A4\u30B3\u30F3\u30FB\u30B3\u30DE\u30F3\u30C9
      \u30D7\u30ED\u30F3\u30D7\u30C8\u306A\u3069\u3067\u72B6\u614B\u3092\u78BA\u8A8D\u3059\u308B\u3002\n4.
      <b>\u5BFE\u51E6\u3059\u308B</b> \u2026 \u539F\u56E0\u306B\u5FDC\u3058\u3066\u8A2D\u5B9A\u3092\u5909\u66F4\u3059\u308B\u3002\n5.
      <color=#8A4B00><b>\u52D5\u4F5C\u3092\u78BA\u8A8D\u3059\u308B</b></color> \u2026
      \u5B9F\u969B\u306B\u4F7F\u3048\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u304B\u78BA\u304B\u3081\u308B\uFF08\u4F8B:
      Web \u30DA\u30FC\u30B8\u306E\u8868\u793A\u3001ping\u3001\u5370\u5237\u306E\u72B6\u614B\uFF09\u3002\n6.
      <b>\u5831\u544A\u3059\u308B</b> \u2026 [\u5BFE\u5FDC\u5B8C\u4E86\u3092\u5831\u544A]
      \u3067\u793E\u54E1\u306B\u78BA\u8A8D\u3057\u3066\u3082\u3089\u3046\u3002<color=#B00000><b>\u76F4\u3063\u3066\u3044\u306A\u3044\u72B6\u614B\u3067\u5831\u544A\u3059\u308B\u3068\u3001\u793E\u54E1\u304B\u3089\u518D\u5EA6\u9023\u7D61\u304C\u6765\u307E\u3059\u3002</b></color>\n\n<b>\u25A0
      \u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u306B\u3064\u306A\u304C\u3089\u306A\u3044\u5834\u5408\u306E\u78BA\u8A8D\u7B87\u6240</b>\n\u30FB\u753B\u9762\u53F3\u4E0B\u306E\u901A\u77E5\u9818\u57DF\u306E\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF
      \u30A2\u30A4\u30B3\u30F3\n\u30FB[\u8A2D\u5B9A] \u2192 [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF]\uFF08Wi-Fi
      \u306E\u72B6\u614B\u3001IP \u30A2\u30C9\u30EC\u30B9\uFF09\n\u30FB[\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A]\uFF08\u30D5\u30A1\u30A4\u30EB\u540D\u3092\u6307\u5B9A\u3057\u3066\u5B9F\u884C:
      ncpa.cpl\uFF09\u2026 \u30A2\u30C0\u30D7\u30BF\u30FC\u306E\u6709\u52B9\uFF0F\u7121\u52B9\n\u30FB\u30B3\u30DE\u30F3\u30C9
      \u30D7\u30ED\u30F3\u30D7\u30C8\uFF08\u30D5\u30A1\u30A4\u30EB\u540D\u3092\u6307\u5B9A\u3057\u3066\u5B9F\u884C:
      cmd\uFF09\n\u3000\u3000ipconfig / ipconfig /all \u2026 IP \u30A2\u30C9\u30EC\u30B9\u30FB\u30B2\u30FC\u30C8\u30A6\u30A7\u30A4\u306E\u78BA\u8A8D\n\u3000\u3000ping
      <\u30DB\u30B9\u30C8\u540D> \u2026 \u76F8\u624B\u306B\u5C4A\u304F\u304B\u306E\u78BA\u8A8D\uFF08\u4F8B:
      ping intranet\uFF09\n\n<b>\u25A0 \u5370\u5237\u3067\u304D\u306A\u3044\u5834\u5408\u306E\u78BA\u8A8D\u7B87\u6240</b>\n\u30FB[\u8A2D\u5B9A]
      \u2192 [\u30D7\u30EA\u30F3\u30BF\u30FC] \u2026 \u30D7\u30EA\u30F3\u30BF\u30FC\u306E\u72B6\u614B\n\u30FB\u30D7\u30EA\u30F3\u30BF\u30FC\u306E\u30AD\u30E5\u30FC\uFF08\u901A\u77E5\u9818\u57DF\u306E\u30D7\u30EA\u30F3\u30BF\u30FC
      \u30A2\u30A4\u30B3\u30F3 / control printers\uFF09\u2026 \u30C9\u30AD\u30E5\u30E1\u30F3\u30C8\u306E\u72B6\u614B\u3068
      [\u30D7\u30EA\u30F3\u30BF\u30FC] \u30E1\u30CB\u30E5\u30FC\n\n<b>\u25A0 \u305D\u306E\u4ED6\u306E\u30C4\u30FC\u30EB</b>\n\u30FB\u30BF\u30B9\u30AF
      \u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\uFF08{KEY:REMOTE_TASKMGR}\uFF09\u2026
      \u5B9F\u884C\u4E2D\u306E\u30A2\u30D7\u30EA\u30B1\u30FC\u30B7\u30E7\u30F3\u30FB\u30D7\u30ED\u30BB\u30B9\u30FB\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u72B6\u6CC1\n\u30FB\u30A8\u30AF\u30B9\u30D7\u30ED\u30FC\u30E9\u30FC\uFF08{KEY:REMOTE_EXPLORER}\uFF09\u2026
      \u30D5\u30A1\u30A4\u30EB\u30FB\u5171\u6709\u30D5\u30A9\u30EB\u30C0\u30FC\uFF08\\\\FILE-SRV01\uFF09\n\u30FB<color=#B00000><b>\u30B7\u30B9\u30C6\u30E0\u306E\u30D7\u30ED\u30BB\u30B9\u306F\u7D42\u4E86\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002</b></color>"
