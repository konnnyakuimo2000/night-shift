%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a728b0253e65334ca61413bf0408212, type: 3}
  m_Name: DOC_TROUBLE_MANUAL
  m_EditorClassIdentifier: 
  documentId: TROUBLE_MANUAL
  title: "PC\u30C8\u30E9\u30D6\u30EB\u5BFE\u5FDC\u30DE\u30CB\u30E5\u30A2\u30EB\uFF08\u30EA\u30E2\u30FC\u30C8\u30B5\u30DD\u30FC\u30C8\uFF09"
  fileName: "\u30C8\u30E9\u30D6\u30EB\u5BFE\u5FDC\u30DE\u30CB\u30E5\u30A2\u30EB.doc"
  icon: helpdesk
  requiredFeature: REMOTE_SUPPORT
  body: 
  sections:
  - title: "\u57FA\u672C\u306E\u6D41\u308C"
    requiredFeature: 
    minimumDay: 0
    text: "\u793E\u54E1PC\u306E\u4E0D\u5177\u5408\u306B\u30EA\u30E2\u30FC\u30C8\u3067\u5BFE\u5FDC\u3059\u308B\u624B\u9806\u3067\u3059\u3002\n{FIG:REMOTE_FLOW}\n1.
      <b>\u75C7\u72B6\u3092\u78BA\u8A8D</b> \u2026 \u554F\u3044\u5408\u308F\u305B\u5185\u5BB9\u3092\u8AAD\u307F\u3001\u4F55\u304C\u3067\u304D\u306A\u3044\u306E\u304B\u3092\u628A\u63E1\u3059\u308B\u3002\n2.
      <b>\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A</b> \u2026 \u53D7\u4ED8\u7BA1\u7406\u306E
      [\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A] \u3067\u793E\u54E1PC\u306B\u63A5\u7D9A\u3059\u308B\u3002\n3.
      <b>\u539F\u56E0\u3092\u8ABF\u3079\u308B</b> \u2026 \u8A2D\u5B9A\u753B\u9762\u30FB\u901A\u77E5\u9818\u57DF\u306E\u30A2\u30A4\u30B3\u30F3\u30FB\u30B3\u30DE\u30F3\u30C9
      \u30D7\u30ED\u30F3\u30D7\u30C8\u306A\u3069\u3067\u72B6\u614B\u3092\u78BA\u8A8D\u3059\u308B\u3002\n4.
      <b>\u5BFE\u51E6\u3059\u308B</b> \u2026 \u539F\u56E0\u306B\u5FDC\u3058\u3066\u8A2D\u5B9A\u3092\u5909\u66F4\u3059\u308B\u3002\n5.
      <color=#8A4B00><b>\u52D5\u4F5C\u3092\u78BA\u8A8D\u3059\u308B</b></color> \u2026
      \u5B9F\u969B\u306B\u4F7F\u3048\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u304B\u78BA\u304B\u3081\u308B\uFF08Web
      \u30DA\u30FC\u30B8\u306E\u8868\u793A\u3001ping\u3001\u5370\u5237\u306E\u72B6\u614B\uFF09\u3002\n6.
      <b>\u5831\u544A\u3059\u308B</b> \u2026 [\u5BFE\u5FDC\u5B8C\u4E86\u3092\u5831\u544A]\u3002<color=#B00000><b>\u76F4\u3063\u3066\u3044\u306A\u3044\u72B6\u614B\u3067\u5831\u544A\u3059\u308B\u3068\u3001\u793E\u54E1\u304B\u3089\u518D\u5EA6\u9023\u7D61\u304C\u6765\u307E\u3059\u3002</b></color>"
  - title: "\u30EA\u30E2\u30FC\u30C8\u753B\u9762\u306E\u898B\u304B\u305F"
    requiredFeature: 
    minimumDay: 0
    text: "{FIG:UI_REMOTE}\n\u30FB<b>\u2460</b> \u901A\u77E5\u9818\u57DF\uFF08\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u30FB\u30D7\u30EA\u30F3\u30BF\u30FC\u306E\u30A2\u30A4\u30B3\u30F3\uFF09\n\u30FB<b>\u2461</b>
      [\u30B9\u30BF\u30FC\u30C8] \u304B\u3089\u8A2D\u5B9A\u30FB\u30B3\u30DE\u30F3\u30C9
      \u30D7\u30ED\u30F3\u30D7\u30C8\u306A\u3069\u3092\u958B\u3051\u307E\u3059\u3002\n\u30FB<b>\u2462</b>
      \u76F4\u3063\u305F\u3053\u3068\u3092\u78BA\u8A8D\u3057\u3066\u304B\u3089 [\u5BFE\u5FDC\u5B8C\u4E86\u3092\u5831\u544A]\u3002"
  - title: "\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u306B\u3064\u306A\u304C\u3089\u306A\u3044"
    requiredFeature: 
    minimumDay: 0
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u306B\u3082\u30E1\u30FC\u30EB\u306B\u3082\u3064\u306A\u304C\u3089\u306A\u3044\u3002\u901A\u77E5\u9818\u57DF\u306E\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF
      \u30A2\u30A4\u30B3\u30F3\u306B \xD7 \u304C\u4ED8\u3044\u3066\u3044\u308B\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF] \u306E Wi-Fi\u3002\u307E\u305F\u306F
      [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A]\uFF08\u30D5\u30A1\u30A4\u30EB\u540D\u3092\u6307\u5B9A\u3057\u3066\u5B9F\u884C:
      ncpa.cpl\uFF09\u306E\u30A2\u30C0\u30D7\u30BF\u30FC\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000Wi-Fi
      \u304C <b>\u30AA\u30D5</b> \u2192 [\u30AA\u30F3] \u306B\u3059\u308B\u3002\u30A2\u30C0\u30D7\u30BF\u30FC\u304C
      <b>\u7121\u52B9</b> \u2192 [\u6709\u52B9\u306B\u3059\u308B]\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u30B3\u30DE\u30F3\u30C9
      \u30D7\u30ED\u30F3\u30D7\u30C8\uFF08cmd\uFF09\u306E [ping intranet] \u3067\u5FDC\u7B54\u304C\u8FD4\u308B\u3002"
  - title: "\u5370\u5237\u3067\u304D\u306A\u3044"
    requiredFeature: 
    minimumDay: 0
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u5370\u5237\u3057\u305F\u306E\u306B\u51FA\u3066\u3053\u306A\u3044\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000\u901A\u77E5\u9818\u57DF\u306E\u30D7\u30EA\u30F3\u30BF\u30FC
      \u30A2\u30A4\u30B3\u30F3\uFF08\u307E\u305F\u306F control printers\uFF09\u3067\u30AD\u30E5\u30FC\u3092\u958B\u304D\u3001\u30D7\u30EA\u30F3\u30BF\u30FC\u540D\u306E\u6A2A\u306E\u72B6\u614B\u3092\u898B\u308B\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000\u300C\u4E00\u6642\u505C\u6B62\u300D\u2192
      [\u30D7\u30EA\u30F3\u30BF\u30FC(P)] \u2192 [\u5370\u5237\u306E\u4E00\u6642\u505C\u6B62]
      \u306E\u30C1\u30A7\u30C3\u30AF\u3092\u5916\u3059\u3002\u300C\u30AA\u30D5\u30E9\u30A4\u30F3\u3067\u4F7F\u7528\u300D\u2192
      \u540C\u3058\u30E1\u30CB\u30E5\u30FC\u3067\u30C1\u30A7\u30C3\u30AF\u3092\u5916\u3059\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u30C9\u30AD\u30E5\u30E1\u30F3\u30C8\u304C\u300C\u5370\u5237\u4E2D\u300D\u306B\u306A\u308A\u3001\u30AD\u30E5\u30FC\u304B\u3089\u6D88\u3048\u308B\u3002"
  - title: "\u611F\u67D3\u304C\u7591\u308F\u308C\u308BPC"
    requiredFeature: 
    minimumDay: 9
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u30D6\u30E9\u30A6\u30B6\u30FC\u304C\u6025\u306B\u7D42\u4E86\u3057\u305F\u3001\u898B\u899A\u3048\u306E\u306A\u3044\u30D5\u30A1\u30A4\u30EB\u304C\u3067\u304D\u305F
      \u306A\u3069\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000\u2014\uFF08\u8ABF\u3079\u308B\u524D\u306B\u3001\u307E\u305A\u5207\u308A\u96E2\u3059\uFF09\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000<color=#8A4B00><b>\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u304B\u3089\u5207\u308A\u96E2\u3059</b></color>:
      [\u8A2D\u5B9A] \u2192 [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF] \u3067 Wi-Fi \u3092\u30AA\u30D5\u3001\u307E\u305F\u306F
      [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A] \u3067\u30A2\u30C0\u30D7\u30BF\u30FC\u3092\u7121\u52B9\u306B\u3002<color=#B00000><b>\u518D\u8D77\u52D5\u306F\u3057\u306A\u3044\uFF08\u75D5\u8DE1\u304C\u6D88\u3048\u308B\uFF09\u3002</b></color>\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u901A\u77E5\u9818\u57DF\u306E\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF
      \u30A2\u30A4\u30B3\u30F3\u306B \xD7 \u304C\u4ED8\u3044\u3066\u3044\u308B\u3002"
  - title: "\u8B66\u544A\u753B\u9762\u304C\u6D88\u3048\u306A\u3044"
    requiredFeature: 
    minimumDay: 10
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u300C\u30A6\u30A4\u30EB\u30B9\u306B\u611F\u67D3\u3057\u3066\u3044\u307E\u3059\u300D\u306A\u3069\u306E\u8D64\u3044\u753B\u9762\u304C\u9589\u3058\u3089\u308C\u306A\u3044\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000\u30BF\u30B9\u30AF
      \u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\uFF08<b>netvoyager.exe</b> = \u30D6\u30E9\u30A6\u30B6\u30FC\uFF09\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000[\u30D7\u30ED\u30BB\u30B9]
      \u30BF\u30D6\u3067\u8B66\u544A\u3092\u51FA\u3057\u3066\u3044\u308B\u30D6\u30E9\u30A6\u30B6\u30FC\u3092\u9078\u3073
      [\u30D7\u30ED\u30BB\u30B9\u306E\u7D42\u4E86]\u3002<color=#B00000><b>\u753B\u9762\u306E\u300C\u99C6\u9664\u30C4\u30FC\u30EB\u3092\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u300D\u306F\u62BC\u3055\u306A\u3044\uFF08\u30B5\u30DD\u30FC\u30C8\u8A50\u6B3A\uFF09\u3002</b></color>\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u8B66\u544A\u306E\u753B\u9762\u304C\u6D88\u3048\u3066\u3044\u308B\u3002"
  - title: "\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0\u306E\u6848\u5185"
    requiredFeature: 
    minimumDay: 11
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u300C\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0\u304C\u3042\u308A\u307E\u3059\u300D\u3068\u51FA\u7D9A\u3051\u3066\u3044\u308B\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0]\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000[\u3059\u3079\u3066\u9069\u7528]
      \u3092\u62BC\u3059\uFF08\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0\u306F\u30BD\u30D5\u30C8\u306E\u5F31\u70B9\u3092\u3075\u3055\u3050\u3082\u306E\uFF09\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u300C\u30B3\u30F3\u30D4\u30E5\u30FC\u30BF\u30FC\u306F\u6700\u65B0\u306E\u72B6\u614B\u3067\u3059\u300D\u3068\u8868\u793A\u3055\u308C\u308B\u3002"
  - title: "Wi-Fi \u306F\u30AA\u30F3\u306A\u306E\u306B\u4F7F\u3048\u306A\u3044"
    requiredFeature: 
    minimumDay: 12
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000Wi-Fi \u306F\u30AA\u30F3\u306A\u306E\u306B\u3001\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u306B\u3082\u30E1\u30FC\u30EB\u306B\u3082\u3064\u306A\u304C\u3089\u306A\u3044\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF] \u306E IP \u30A2\u30C9\u30EC\u30B9\u306E\u8A2D\u5B9A\uFF08\u300C\u624B\u52D5\u300D\u306B\u306A\u3063\u3066\u3044\u306A\u3044\u304B\uFF09\u3002cmd
      \u306E ipconfig \u3067\u3082\u78BA\u8A8D\u3067\u304D\u308B\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000\u300CIP
      \u30A2\u30C9\u30EC\u30B9\u3092\u81EA\u52D5\u7684\u306B\u53D6\u5F97\u3059\u308B\u300D\uFF08DHCP\uFF09\u306B\u30C1\u30A7\u30C3\u30AF\u3092\u5165\u308C\u308B\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000[ping
      intranet] \u3067\u5FDC\u7B54\u304C\u8FD4\u308B\u3002"
  - title: "\u540D\u524D\u3067\u958B\u3051\u306A\u3044"
    requiredFeature: 
    minimumDay: 13
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000IP \u30A2\u30C9\u30EC\u30B9\u3092\u76F4\u63A5\u5165\u308C\u308B\u3068\u958B\u3051\u308B\u306E\u306B\u3001intranet
      \u306A\u3069\u306E\u540D\u524D\u3067\u306F\u958B\u3051\u306A\u3044\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF] \u306E DNS \u30B5\u30FC\u30D0\u30FC\u306E\u8A2D\u5B9A\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000\u300CDNS
      \u30B5\u30FC\u30D0\u30FC\u306E\u30A2\u30C9\u30EC\u30B9\u3092\u81EA\u52D5\u7684\u306B\u53D6\u5F97\u3059\u308B\u300D\u306B\u30C1\u30A7\u30C3\u30AF\u3092\u5165\u308C\u308B\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000[ping
      intranet] \u3067\u5FDC\u7B54\u304C\u8FD4\u308B\u3002"
  - title: "\u96E2\u5E2D\u4E2D\u306E\u753B\u9762\u30ED\u30C3\u30AF"
    requiredFeature: 
    minimumDay: 14
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u96E2\u5E2D\u4E2D\u306B\u4ED6\u4EBA\u306BPC\u3092\u89E6\u3089\u308C\u305F\u6C17\u304C\u3059\u308B\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u753B\u9762] \u306E\u30B9\u30AF\u30EA\u30FC\u30F3 \u30BB\u30FC\u30D0\u30FC\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000\u300C\u30D1\u30B9\u30EF\u30FC\u30C9\u3067\u4FDD\u8B77\u3059\u308B\u300D\u306B\u30C1\u30A7\u30C3\u30AF\u3092\u5165\u308C\u308B\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u30C1\u30A7\u30C3\u30AF\u304C\u5165\u3063\u3066\u3044\u308B\u3002"
  - title: "\u30B5\u30FC\u30D0\u30FC\u306B\u3064\u306A\u304C\u3089\u306A\u3044"
    requiredFeature: 
    minimumDay: 15
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u5171\u6709\u30D5\u30A9\u30EB\u30C0\u30FC\u304C\u958B\u3051\u306A\u3044\u3002\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u306F\u4F7F\u3048\u308B\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000cmd
      \u306E [ping file-srv01]\u3002PC \u306E\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u8A2D\u5B9A\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000PC
      \u306E\u8A2D\u5B9A\u306B\u554F\u984C\u304C\u306A\u304F\u3001ping \u304C\u5C4A\u304B\u306A\u3044
      \u2192 <color=#8A4B00><b>[\u30B5\u30FC\u30D0\u30FC\u5074\u306E\u969C\u5BB3\u3068\u3057\u3066\u5831\u544A]</b></color>\uFF08PC
      \u5074\u3067\u306F\u76F4\u305B\u306A\u3044\uFF09\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u2014"
  - title: "\u8A18\u9332\uFF08\u30ED\u30B0\uFF09\u3092\u6B8B\u3059"
    requiredFeature: 
    minimumDay: 18
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u4E0D\u6B63\u306E\u7591\u3044\u304C\u3042\u308B\u306E\u3067\u3001\u8ABF\u3079\u308B\u524D\u306B\u8A18\u9332\u3092\u6B8B\u3057\u3066\u307B\u3057\u3044\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u30A4\u30D9\u30F3\u30C8\u30ED\u30B0]\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000[\u30ED\u30B0\u3092\u30D5\u30ED\u30C3\u30D4\u30FC\u306B\u4FDD\u5B58]\u3002<color=#B00000><b>[\u30ED\u30B0\u3092\u6D88\u53BB]
      \u306F\u62BC\u3055\u306A\u3044\uFF08\u8A3C\u62E0\u304C\u6D88\u3048\u308B\uFF09\u3002</b></color>\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u300C\u30D5\u30ED\u30C3\u30D4\u30FC\u306B\u4FDD\u5B58\u6E08\u307F\u300D\u3068\u8868\u793A\u3055\u308C\u308B\u3002"
  - title: "\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u3092\u53D6\u308B"
    requiredFeature: 
    minimumDay: 19
    text: "<b>\u3010\u75C7\u72B6\u3011</b>\u3000\u30D5\u30A1\u30A4\u30EB\u306E\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u3092\u53D6\u3063\u3066\u307B\u3057\u3044\u3002\n<b>\u3010\u898B\u308B\u5834\u6240\u3011</b>\u3000[\u8A2D\u5B9A]
      \u2192 [\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7]\u3002\n<color=#8A4B00><b>\u3010\u76F4\u3057\u65B9\u3011</b></color>\u3000[MO
      \u306B\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u3057\u3066\u53D6\u308A\u5916\u3059]\uFF08\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u3084
      PC \u304B\u3089\u5207\u308A\u96E2\u3057\u3066\u4FDD\u7BA1\u3059\u308B\uFF09\u3002\n<b>\u3010\u78BA\u8A8D\u3011</b>\u3000\u300C\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u6E08\u307F\u300D\u3068\u8868\u793A\u3055\u308C\u308B\u3002"
  - title: "\u305D\u306E\u4ED6\u306E\u30C4\u30FC\u30EB"
    requiredFeature: 
    minimumDay: 0
    text: "\u30FB\u30B3\u30DE\u30F3\u30C9 \u30D7\u30ED\u30F3\u30D7\u30C8\uFF08\u30D5\u30A1\u30A4\u30EB\u540D\u3092\u6307\u5B9A\u3057\u3066\u5B9F\u884C:
      cmd\uFF09\u2026 ipconfig\uFF08IP \u30A2\u30C9\u30EC\u30B9\uFF09\u3001ping <\u540D\u524D>\uFF08\u76F8\u624B\u306B\u5C4A\u304F\u304B\uFF09\n\u30FB\u30BF\u30B9\u30AF
      \u30DE\u30CD\u30FC\u30B8\u30E3\u30FC \u2026 \u5B9F\u884C\u4E2D\u306E\u30A2\u30D7\u30EA\u30B1\u30FC\u30B7\u30E7\u30F3\u30FB\u30D7\u30ED\u30BB\u30B9\u30FB\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u72B6\u6CC1\n\u30FB\u30A8\u30AF\u30B9\u30D7\u30ED\u30FC\u30E9\u30FC
      \u2026 \u30D5\u30A1\u30A4\u30EB\u30FB\u5171\u6709\u30D5\u30A9\u30EB\u30C0\u30FC\n\uFF08\u30AD\u30FC\u64CD\u4F5C\u306F\u300C\u64CD\u4F5C\u30DE\u30CB\u30E5\u30A2\u30EB\u300D\u306E
      [\u30EA\u30E2\u30FC\u30C8PC\u306E\u30AD\u30FC\u64CD\u4F5C] \u3092\u53C2\u7167\uFF09\n\u30FB<color=#B00000><b>\u30B7\u30B9\u30C6\u30E0\u306E\u30D7\u30ED\u30BB\u30B9\u306F\u7D42\u4E86\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002</b></color>"
