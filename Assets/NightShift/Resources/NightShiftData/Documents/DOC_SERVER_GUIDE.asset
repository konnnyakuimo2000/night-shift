  m_Script: {fileID: 11500000, guid: 0a728b0253e65334ca61413bf0408212, type: 3}
  m_Name: DOC_SERVER_GUIDE
  m_EditorClassIdentifier: 
  documentId: SERVER_GUIDE
  title: "\u793E\u5185\u30B5\u30FC\u30D0\u30FC\u69CB\u6210\u8CC7\u6599"
  fileName: "\u793E\u5185\u30B5\u30FC\u30D0\u30FC\u69CB\u6210\u8CC7\u6599.doc"
  icon: server
  requiredFeature: SERVER_GUIDE
  body: "\u793E\u5185\u306E\u30B5\u30FC\u30D0\u30FC\u3068\u3001\u63A5\u7D9A\u306B\u5FC5\u8981\u306A\u6A29\u9650\u306E\u65E9\u898B\u8868\u3067\u3059\u3002\u30B5\u30FC\u30D0\u30FC\u306E\u7BA1\u7406\u64CD\u4F5C\uFF08\u30B5\u30FC\u30D3\u30B9\u505C\u6B62\u30FB\u518D\u8D77\u52D5\u306A\u3069\uFF09\u306F\u3001\u307E\u3060\u62C5\u5F53\u7BC4\u56F2\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
  sections:
  - requiredFeature: 
    text: "<b>\u25A0 \u65E9\u898B\u8868: \u63A5\u7D9A\u5148 \u2192 \u63A5\u7D9A\u7A2E\u5225
      \u2192 \u5FC5\u8981\u306A\u6A29\u9650</b>\n\u63A5\u7D9A\u8981\u6C42\u306E\u300C\u63A5\u7D9A\u5148\u300D\u3068\u300C\u63A5\u7D9A\u7A2E\u5225\u300D\u3092\u4E0B\u306E\u8868\u3067\u63A2\u3057\u3001\u53F3\u5074\u306E\u6A29\u9650\u304C\u793E\u54E1\u60C5\u5831\u3067
      \u25CB \u304B \xD7 \u304B\u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002\n{ACCESS_TABLE}\n\u30FB<b>\u300C\u7BA1\u7406\u8005\u300D\u3068\u3064\u304F\u6A29\u9650\u306F1\u7A2E\u985E\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002</b>
      \u4F8B: <b>\u30ED\u30FC\u30AB\u30EB\u7BA1\u7406\u8005</b> \u306F\u81EA\u5206\u306EPC\u306E\u7BA1\u7406\u6A29\u9650\u3067\u3001<color=#8A4B00><b>\u30B5\u30FC\u30D0\u30FC\u7BA1\u7406\u8005</b></color>
      \u3068\u306F\u5225\u3067\u3059\u3002"
  - requiredFeature: NETWORK_MAP
    text: "<b>\u25A0 \u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u306E\u533A\u5206</b>\n{FIG:NETWORK_ZONES}\n\u30FB<b>\u793E\u5916
      (INTERNET)</b> \u2026 \u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u3002\u3059\u3079\u3066\u306E\u793E\u5916\u304B\u3089\u306E\u901A\u4FE1\u306F
      FIREWALL \u3092\u901A\u308A\u307E\u3059\u3002\n\u30FB<b>\u516C\u958B (DMZ)</b>
      \u2026 \u793E\u5916\u306B\u516C\u958B\u3057\u3066\u3044\u308B Web \u30B5\u30FC\u30D0\u30FC\u3002\u793E\u5916\u304B\u3089\u306E\u30A2\u30AF\u30BB\u30B9\u306F\u65E5\u5E38\u7684\u306B\u767A\u751F\u3057\u307E\u3059\u3002\n\u30FB<b>\u793E\u5185</b>
      \u2026 \u696D\u52D9\u30B7\u30B9\u30C6\u30E0\u3002\u793E\u5916\u304B\u3089\u5229\u7528\u3059\u308B\u5834\u5408\u306F
      <color=#8A4B00><b>VPN \u7D4C\u7531</b></color> \u304C\u5FC5\u8981\u3067\u3059\u3002\n\u30FB<b>\u793E\u54E1\u7AEF\u672B
      (EMPLOYEE PCs)</b> \u2026 \u5404\u793E\u54E1\u306E\u767B\u9332PC\u3002\n\n<b>\u25A0
      \u30B5\u30FC\u30D0\u30FC\u4E00\u89A7\uFF08\u533A\u5206\u30FB\u63A5\u7D9A\u7A2E\u5225\u3068\u5FC5\u8981\u306A\u6A29\u9650\uFF09</b>\n{SERVER_LIST}\n\n<b>\u25A0
      \u88DC\u8DB3</b>\n\u30FB<color=#B00000><b>\u7BA1\u7406\u7CFB</b></color> \u306E\u30B5\u30FC\u30D0\u30FC\u3078\u306E\u30ED\u30B0\u30A4\u30F3\u306B\u306F\u3001<color=#8A4B00><b>\u30B5\u30FC\u30D0\u30FC\u7BA1\u7406\u8005</b></color>
      \u306A\u3069\u306E\u7BA1\u7406\u8005\u6A29\u9650\u304C\u5FC5\u8981\u3067\u3059\u3002\n\u30FB<b>\u91CD\u8981</b>
      \u306E\u30B5\u30FC\u30D0\u30FC\u306F\u696D\u52D9\u30C7\u30FC\u30BF\u3092\u6271\u3044\u307E\u3059\u3002\u767B\u9332\u3055\u308C\u3066\u3044\u306A\u3044\u7AEF\u672B\u304B\u3089\u306E\u5229\u7528\u306F\u8A8D\u3081\u3089\u308C\u3066\u3044\u307E\u305B\u3093\u3002"
