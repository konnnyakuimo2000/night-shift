%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a728b0253e65334ca61413bf0408212, type: 3}
  m_Name: DOC_SYSTEM_MANUAL
  m_EditorClassIdentifier: 
  documentId: SYSTEM_MANUAL
  title: "\u793E\u5185\u60C5\u5831\u30B7\u30B9\u30C6\u30E0 \u64CD\u4F5C\u30DE\u30CB\u30E5\u30A2\u30EB\uFF08\u591C\u9593\u904B\u7528\u62C5\u5F53\u5411\u3051\uFF09"
  fileName: "\u696D\u52D9\u30B7\u30B9\u30C6\u30E0\u64CD\u4F5C\u30DE\u30CB\u30E5\u30A2\u30EB.doc"
  icon: doc
  requiredFeature: 
  body: 
  sections:
  - title: "\u306F\u3058\u3081\u306B\uFF08\u5224\u65AD\u306E\u6D41\u308C\uFF09"
    requiredFeature: 
    text: "\u591C\u9593\u904B\u7528\u62C5\u5F53\u306E\u4E3B\u306A\u4ED5\u4E8B\u306F\u3001\u793E\u5185\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u3078\u306E
      <b>\u63A5\u7D9A\u8981\u6C42</b> \u3092\u5BE9\u67FB\u3059\u308B\u3053\u3068\u3067\u3059\u3002\n\u5C4A\u3044\u305F\u8981\u6C42\u30921\u4EF6\u305A\u3064\u9078\u3073\u3001\u793E\u54E1\u60C5\u5831\u3068\u7167\u3089\u3057\u5408\u308F\u305B\u3066
      <color=#0030A0><b>\u8A31\u53EF</b></color> \u304B <color=#B00000><b>\u62D2\u5426</b></color>
      \u3092\u6C7A\u3081\u307E\u3059\u3002\n\n\u4E0B\u306E\u56F3\u306F\u3001\u672C\u65E5\u306E\u30EB\u30FC\u30EB\u3067\u306E\u5224\u65AD\u306E\u6D41\u308C\u3067\u3059\uFF08\u62C5\u5F53\u7BC4\u56F2\u304C\u5E83\u304C\u308B\u3068\u6BB5\u968E\u304C\u5897\u3048\u307E\u3059\uFF09\u3002\n{FIG:REVIEW_FLOW}\n\u30FB\u8FF7\u3063\u305F\u3089\u3001\u307E\u305A\u8ABF\u3079\u308B\u3053\u3068\u3002<b>\u30DA\u30FC\u30B8\u306E\u8D64\u3044\u67A0</b>
      \u304C\u3001\u5404\u696D\u52D9\u3067\u898B\u308B\u5834\u6240\u3067\u3059\u3002"
  - title: "\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB"
    requiredFeature: CONNECTION_MONITOR
    text: "[\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A\u76E3\u8996] \u306E\u753B\u9762\u3067\u3059\u3002\u8981\u6C42\u304C\u5C4A\u304F\u3068\u753B\u9762\u53F3\u4E0B\u306B\u901A\u77E5\u304C\u51FA\u307E\u3059\u3002\n{FIG:UI_CONNECTION}\n\u30FB<b>\u2460</b>
      \u4E00\u89A7\u304B\u3089\u8981\u6C42\u30921\u4EF6\u9078\u3073\u307E\u3059\u3002\n\u30FB<b>\u2461</b>
      \u8981\u6C42\u5185\u5BB9\u306E <b>\u5229\u7528\u8005\u30FB\u793E\u54E1\u756A\u53F7</b>
      \u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002\n\u30FB<b>\u2462</b> [\u793E\u54E1\u60C5\u5831\u3092\u53C2\u7167]
      \u3067\u793E\u54E1\u60C5\u5831\u306E\u753B\u9762\u304C\u958B\u304D\u307E\u3059\u3002<b>\u793E\u54E1\u756A\u53F7\u3084\u6C0F\u540D\u3092\u81EA\u5206\u3067\u5165\u529B\u3057\u3066\u691C\u7D22</b>\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30FB<b>\u2463</b>
      \u78BA\u8A8D\u3067\u304D\u305F\u3089 <color=#0030A0><b>\u63A5\u7D9A\u3092\u8A31\u53EF</b></color>
      \u304B <color=#B00000><b>\u63A5\u7D9A\u3092\u62D2\u5426</b></color> \u3092\u62BC\u3057\u307E\u3059\u3002<b>\u51E6\u7406\u5F8C\u306E\u53D6\u308A\u6D88\u3057\u306F\u3067\u304D\u307E\u305B\u3093\u3002</b>\n\u30FB\u672C\u756A\u306E\u696D\u52D9\u3067\u306F\u3001\u8981\u6C42\u306B
      <b>\u53D7\u4ED8\u304B\u3089\u306E\u671F\u9650</b> \u304C\u3042\u308A\u307E\u3059\uFF08<b>\u7814\u4FEE\u671F\u9593\u4E2D\u306F\u671F\u9650\u5207\u308C\u306B\u306A\u308A\u307E\u305B\u3093</b>\uFF09\u3002"
  - title: "\u793E\u54E1\u306E\u691C\u7D22"
    requiredFeature: EMPLOYEE_DIRECTORY
    text: "[\u793E\u54E1\u60C5\u5831\u306E\u691C\u7D22\u30FB\u53C2\u7167] \u306E\u753B\u9762\u3067\u3059\u3002\n{FIG:UI_DIRECTORY}\n\u30FB<b>\u2460</b>
      \u793E\u54E1\u756A\u53F7\u3084\u6C0F\u540D\u3092\u5165\u529B\u3057\u3066 [\u691C\u7D22\u958B\u59CB]\u3002\n\u30FB<b>\u2461</b>
      \u7D50\u679C\u306E\u4E00\u89A7\u306B\u51FA\u3066\u304F\u308C\u3070\u793E\u54E1\u3067\u3059\u3002<color=#B00000><b>\u898B\u3064\u304B\u3089\u306A\u3051\u308C\u3070\u3001\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002</b></color>"
  - title: "\u7AEF\u672B\u306E\u78BA\u8A8D"
    requiredFeature: DEVICE_CHECK
    text: "\u8981\u6C42\u306E <b>\u7AEF\u672B</b> \u3068\u3001\u793E\u54E1\u306E
      <b>\u767B\u9332\u7AEF\u672B</b> \u304C\u540C\u3058\u304B\u3092\u898B\u6BD4\u3079\u307E\u3059\u3002\n{FIG:UI_DEVICE}\n\u30FB<b>\u2460</b>
      \u63A5\u7D9A\u8981\u6C42\u306E\u300C\u7AEF\u672B\u300D\n\u30FB<b>\u2461</b>
      \u793E\u54E1\u60C5\u5831\u306E\u300C\u767B\u9332\u7AEF\u672B\u300D\n\u30FB<color=#B00000><b>\u793E\u54E1\u672C\u4EBA\u3067\u3082\u3001\u5225\u306E\u7AEF\u672B\uFF08\u4ED6\u4EBA\u306EPC\u30FB\u79C1\u7269\u306EPC\uFF09\u304B\u3089\u306E\u63A5\u7D9A\u306F\u62D2\u5426\u3067\u3059\u3002</b></color>"
  - title: "\u793E\u54E1\u306E\u8A73\u7D30"
    requiredFeature: EMPLOYEE_DETAIL
    text: "\u691C\u7D22\u7D50\u679C\u3092\u30C0\u30D6\u30EB\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u304B
      [\u8A73\u7D30\u8868\u793A] \u3067\u3001\u793E\u54E1\u306E\u8A73\u7D30\u3092\u958B\u304D\u307E\u3059\u3002\n{FIG:UI_DETAIL}\n\u30FB<b>\u2460</b>
      \u9854\u5199\u771F\u30FB\u6240\u5C5E\u30FB\u52E4\u52D9\u72B6\u614B\n\u30FB<b>\u2461</b>
      \u767B\u9332\u7AEF\u672B\u3068 VPN\u7AEF\u672B\uFF08\u793E\u5916\u304B\u3089\u4F7F\u3046\u767B\u9332\u30CE\u30FC\u30C8PC\uFF09"
  - title: "\u6A29\u9650\u306E\u78BA\u8A8D"
    requiredFeature: EMPLOYEE_PERMISSIONS
    text: "\u8981\u6C42\u306E <b>\u5FC5\u8981\u306A\u6A29\u9650</b> \u3068 <b>\u540C\u3058\u540D\u524D\u306E\u884C</b>
      \u3092\u3001\u793E\u54E1\u306E\u6A29\u9650\u6B04\u3067\u63A2\u3057\u307E\u3059\u3002\n{FIG:UI_PERMISSION}\n\u30FB<b>\u2460</b>
      \u63A5\u7D9A\u8981\u6C42\u306E\u300C\u5FC5\u8981\u306A\u6A29\u9650\u300D\uFF08\u4F8B:
      \u4EBA\u4E8B\u30B7\u30B9\u30C6\u30E0\uFF09\n\u30FB<b>\u2461</b> \u793E\u54E1\u8A73\u7D30\u306E\u6A29\u9650\u6B04\u3067\u540C\u3058\u540D\u524D\u306E\u884C\u3092\u63A2\u3057\u3001<color=#0030A0><b>\u25CB
      \u306A\u3089\u8A31\u53EF</b></color>\u3001<color=#B00000><b>\xD7 \u306A\u3089\u62D2\u5426</b></color>\u3002\n\u30FB\u793E\u54E1\u8A73\u7D30\u306E
      <b>\u3010\u666E\u6BB5\u4F7F\u3046\u30B7\u30B9\u30C6\u30E0\u3011</b> \u306F\u53C2\u8003\u60C5\u5831\u3067\u3059\u3002\u5224\u65AD\u306B\u306F\u4F7F\u3044\u307E\u305B\u3093\u3002"
  - title: "\u7BA1\u7406\u8005\u6A29\u9650"
    requiredFeature: ADMIN_PERMISSIONS
    text: "\u7BA1\u7406\u7528\u306E\u30B5\u30FC\u30D0\u30FC\uFF08ADMIN-SRV01\uFF09\u3078\u306E\u63A5\u7D9A\u306B\u306F
      <b>\u30B5\u30FC\u30D0\u30FC\u7BA1\u7406\u8005</b> \u306E\u6A29\u9650\u304C\u5FC5\u8981\u3067\u3059\u3002\n{FIG:UI_ADMIN}\n\u30FB<b>\u2460</b>
      \u5FC5\u8981\u306A\u6A29\u9650\u304C\u300C\u30B5\u30FC\u30D0\u30FC\u7BA1\u7406\u8005\u300D\u306E\u8981\u6C42\n\u30FB<b>\u2461</b>
      \u793E\u54E1\u8A73\u7D30\u306E <b>\u3010\u7BA1\u7406\u8005\u6A29\u9650\u3011</b>
      \u306E\u6B04\u3067\u300C\u30B5\u30FC\u30D0\u30FC\u7BA1\u7406\u8005\u300D\u3092\u898B\u307E\u3059\u3002\n\u30FB<color=#B00000><b>\u300C\u30ED\u30FC\u30AB\u30EB\u7BA1\u7406\u8005\u300D\u306F\u81EA\u5206\u306EPC\u306E\u7BA1\u7406\u6A29\u9650\u3067\u3001\u30B5\u30FC\u30D0\u30FC\u7BA1\u7406\u8005\u3068\u306F\u5225\u3067\u3059\u3002</b></color>"
  - title: "IT\u30B5\u30DD\u30FC\u30C8\u53D7\u4ED8"
    requiredFeature: HELPDESK
    text: "[IT\u30B5\u30DD\u30FC\u30C8\u53D7\u4ED8\u7BA1\u7406] \u306E\u753B\u9762\u3067\u3059\u3002\u793E\u54E1\u304B\u3089\u306E\u554F\u3044\u5408\u308F\u305B\u304C\u5C4A\u304D\u307E\u3059\u3002\n{FIG:UI_HELPDESK}\n\u30FB<b>\u2460</b>
      \u53D7\u4ED8\u4E00\u89A7\u3002\u533A\u5206\u304C <b>\u76F8\u8AC7</b> \u304B
      <b>\u969C\u5BB3</b> \u304B\u3092\u898B\u307E\u3059\u3002\n\u30FB<b>\u2461</b>
      \u554F\u3044\u5408\u308F\u305B\u5185\u5BB9\uFF08\u793E\u54E1\u304B\u3089\u306E\u30E1\u30C3\u30BB\u30FC\u30B8\uFF09\n\u30FB<b>\u2462</b>
      \u76F8\u8AC7 \u2192 \u56DE\u7B54\u3092\u9078\u3093\u3067 [\u56DE\u7B54\u3092\u9001\u4FE1]\u3002\u969C\u5BB3
      \u2192 [\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A] \u3067\u793E\u54E1\u306EPC\u3092\u76F4\u3057\u307E\u3059\u3002\n\u30FB<color=#B00000><b>\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A\u4E2D\u3082\u696D\u52D9\u6642\u9593\u306F\u9032\u307F\u307E\u3059\u3002</b></color>
      \u624B\u9806\u306F\u300C\u30C8\u30E9\u30D6\u30EB\u5BFE\u5FDC\u30DE\u30CB\u30E5\u30A2\u30EB\u300D\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - title: "\u793E\u5916\u304B\u3089\u306E\u63A5\u7D9A"
    requiredFeature: SYSTEM_LOG
    text: "\u63A5\u7D9A\u8981\u6C42\u306E <b>\u63A5\u7D9A\u5143</b> \u304C <color=#8A4B00><b>\u300C\u793E\u5916\u300D</b></color>
      \u306E\u3068\u304D\u306F\u3001\u6B21\u306E3\u3064\u3060\u3051\u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002\n{FIG:UI_EXTERNAL}\n\u30FB<b>\u2460</b>
      \u5229\u7528\u30B7\u30B9\u30C6\u30E0\u304C <b>\u300CVPN\u63A5\u7D9A\u300D</b>
      \u304B\n\u30FB<b>\u2461</b> \u793E\u54E1\u60C5\u5831\u306E <b>\u300CVPN\u5229\u7528\u300D</b>
      \u304C <color=#0030A0><b>\u8A31\u53EF</b></color> \u304B\n\u30FB<b>\u2462</b>
      \u63A5\u7D9A\u8981\u6C42\u306E\u7AEF\u672B\u304C\u3001\u793E\u54E1\u60C5\u5831\u306E
      <b>\u300CVPN\u7AEF\u672B\u300D</b> \u3068\u540C\u3058\u304B\n{FIG:EXTERNAL_FLOW}\n\u30FB<color=#B00000><b>\u7BA1\u7406\u8005\u3067\u3082\u3001\u793E\u5916\u304B\u3089\u306F\u300CVPN\u63A5\u7D9A\u300D\u4EE5\u5916\u306F\u62D2\u5426\u3067\u3059\u3002</b></color>"
  - title: "\u30B7\u30B9\u30C6\u30E0\u30ED\u30B0"
    requiredFeature: SYSTEM_LOG
    text: "[\u30B7\u30B9\u30C6\u30E0\u30ED\u30B0\u306E\u691C\u7D22\u30FB\u53C2\u7167]
      \u306E\u753B\u9762\u3067\u3059\u3002\u793E\u5185\u306E\u901A\u4FE1\u30FB\u51E6\u7406\u306E\u8A18\u9332\u304C\u6B8B\u308A\u307E\u3059\u3002\n{FIG:UI_LOG}\n\u30FB<b>\u2460</b>
      <b>\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u8B66\u544A</b> \u304C\u51FA\u305F\u3089\u3001\u8981\u6C42\u306E\u63A5\u7D9A\u5143\uFF08IP\u30A2\u30C9\u30EC\u30B9\uFF09\u3092\u30AD\u30FC\u30EF\u30FC\u30C9\u306B\u5165\u308C\u3066
      [\u691C\u7D22\u958B\u59CB]\u3002\n\u30FB<b>\u2461</b> \u540C\u3058IP\u304C
      <b>\u524D\u306B\u4F55\u3092\u3057\u3066\u3044\u305F\u304B</b>\uFF08\u30DD\u30FC\u30C8\u30B9\u30AD\u30E3\u30F3\u306A\u3069\uFF09\u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002\n\u30FB\u884C\u3092\u30C0\u30D6\u30EB\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u3001\u305D\u306E\u63A5\u7D9A\u5143\u3067\u7D5E\u308A\u8FBC\u307F\u307E\u3059\u3002\u30ED\u30B0\u306F\u81EA\u52D5\u3067\u306F\u5206\u6790\u3055\u308C\u307E\u305B\u3093\u3002"
  - title: "\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u30DE\u30C3\u30D7"
    requiredFeature: NETWORK_MAP
    text: "\u901A\u4FE1\u306E\u6D41\u308C\uFF08\u63A5\u7D9A\u5143 \u2192 \u63A5\u7D9A\u5148\uFF09\u3092\u8868\u793A\u3057\u307E\u3059\u3002\u30B5\u30FC\u30D0\u30FC\u306F\u76E3\u8996\u306E\u307F\u3067\u3001\u64CD\u4F5C\u306F\u3067\u304D\u307E\u305B\u3093\u3002\n\u793E\u5185\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u306E\u533A\u5206\u306F\u300C\u793E\u5185\u30B5\u30FC\u30D0\u30FC\u69CB\u6210\u8CC7\u6599\u300D\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - title: "\u30A2\u30AB\u30A6\u30F3\u30C8\u3068\u30AD\u30FC\u64CD\u4F5C"
    requiredFeature: 
    text: "\u30FB\u30ED\u30B0\u30A4\u30F3\u30D1\u30B9\u30EF\u30FC\u30C9\u306F [\u30E1\u30A4\u30F3\u30E1\u30CB\u30E5\u30FC]
      \u2192 [\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u5909\u66F4] \u3067\u5909\u66F4\u3067\u304D\u307E\u3059\u3002<b>\u30D1\u30B9\u30EF\u30FC\u30C9\u306F\u4ED6\u4EBA\u306B\u6559\u3048\u306A\u3044\u3053\u3068\u3002</b>\n\u30FB\u30A6\u30A3\u30F3\u30C9\u30A6\u5207\u66FF:
      {KEY:SWITCH} / Alt+PageUp\u3000\u30FB\u9589\u3058\u308B: {KEY:CLOSE}\u3000\u30FB\u4E00\u6642\u505C\u6B62:
      {KEY:PAUSE}\u3000\u30FB\u30E1\u30FC\u30EB: {KEY:MAIL}\n\u30FB\u63A5\u7D9A\u3092\u8A31\u53EF:
      {KEY:ALLOW}\u3000\u30FB\u63A5\u7D9A\u3092\u62D2\u5426: {KEY:BLOCK}\u3000\u30FB\u793E\u54E1\u60C5\u5831\u3092\u53C2\u7167:
      {KEY:LOOKUP}\n\u30FB\u30E1\u30A4\u30F3\u30E1\u30CB\u30E5\u30FC\u306E\u5404\u30B7\u30B9\u30C6\u30E0\u306F
      1\u301C7 \u306E\u30AD\u30FC\u3067\u3082\u958B\u3051\u307E\u3059\u3002\n\uFF08\u30AD\u30FC\u306E\u5272\u308A\u5F53\u3066\u306F
      {KEY:PAUSE}\uFF08\u4E00\u6642\u505C\u6B62\uFF09\u2192 [\u30B7\u30B9\u30C6\u30E0\u8A2D\u5B9A]
      \u2192 [\u30AD\u30FC\u8A2D\u5B9A] \u3067\u5909\u66F4\u3067\u304D\u307E\u3059\uFF09"
  - title: "\u30EA\u30E2\u30FC\u30C8PC\u306E\u30AD\u30FC\u64CD\u4F5C"
    requiredFeature: REMOTE_SUPPORT
    text: "\u30FB\u30B9\u30BF\u30FC\u30C8 {KEY:REMOTE_START} / \u30D5\u30A1\u30A4\u30EB\u540D\u3092\u6307\u5B9A\u3057\u3066\u5B9F\u884C
      {KEY:REMOTE_RUN} / \u30A8\u30AF\u30B9\u30D7\u30ED\u30FC\u30E9\u30FC {KEY:REMOTE_EXPLORER}\n\u30FB\u8A2D\u5B9A
      {KEY:REMOTE_SETTINGS} / \u30C7\u30B9\u30AF\u30C8\u30C3\u30D7 {KEY:REMOTE_DESKTOP}
      / \u30BF\u30B9\u30AF \u30DE\u30CD\u30FC\u30B8\u30E3\u30FC {KEY:REMOTE_TASKMGR}
      / \u66F4\u65B0 {KEY:REFRESH}\n\uFF08Windows \u30AD\u30FC\u3084 Alt+Tab \u306F\u624B\u5143\u306EPC\u304C\u51E6\u7406\u3059\u308B\u305F\u3081\u3001\u4E0A\u8A18\u306E\u30AD\u30FC\u3092\u4F7F\u3063\u3066\u304F\u3060\u3055\u3044\uFF09"
  - title: "\u672C\u756A\u696D\u52D9\u306E\u5FC3\u5F97"
    requiredFeature: STORE
    text: "\u672C\u65E5\u304B\u3089 <b>\u672C\u756A\u696D\u52D9</b> \u3067\u3059\u3002\u7814\u4FEE\u671F\u9593\u3068\u306F\u6B21\u306E\u70B9\u304C\u9055\u3044\u307E\u3059\u3002\n\u30FB<b>\u696D\u52D9\u6642\u9593\u306F
      00:00\u301C06:00</b>\u3002\n\u30FB\u63A5\u7D9A\u8981\u6C42\u30FB\u554F\u3044\u5408\u308F\u305B\u306F
      <b>\u3044\u3064\u30FB\u3044\u304F\u3064\u5C4A\u304F\u304B\u5206\u304B\u308A\u307E\u305B\u3093</b>\u3002<b>\u540C\u6642\u306B\u5C4A\u304F</b>\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\n\u30FB\u63A5\u7D9A\u8981\u6C42\u306B\u306F
      <color=#B00000><b>\u671F\u9650</b></color> \u304C\u3042\u308A\u307E\u3059\u3002\u671F\u9650\u5207\u308C\u306F
      <b>\u7F70\u91D1</b>\uFF08\u696D\u52D9\u6539\u5584\u5354\u529B\u91D1\uFF09\u306E\u5BFE\u8C61\u3067\u3059\u3002\n\u30FB<b>\u8FF7\u3063\u305F\u3089\u3001\u307E\u305A\u8ABF\u3079\u308B\u3053\u3068\u3002</b>
      \u5168\u90E8\u3092\u4E00\u5EA6\u306B\u898B\u3088\u3046\u3068\u305B\u305A\u3001\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u8B66\u544A\u304B\u3089\u9806\u306B\u3002\n\u30FB\u696D\u52D9\u306B\u4F7F\u3046\u6A5F\u6750\u30FB\u30C4\u30FC\u30EB\u306F
      <b>\u793E\u5185\u8CFC\u8CB7\u30B7\u30B9\u30C6\u30E0</b> \u3067\u8CFC\u5165\u3067\u304D\u307E\u3059\uFF08\u8CBB\u7528\u306F\u7D66\u4E0E\u304B\u3089\u7CBE\u7B97\uFF09\u3002"
  - title: "\u63A5\u7D9A\u5143IP\u306E\u7167\u5408"
    requiredFeature: IP_CHECK
    text: "\u793E\u5185\u306E\u767B\u9332\u7AEF\u672B\u304B\u3089\u306E\u8981\u6C42\u306F\u3001<b>\u63A5\u7D9A\u5143\u306EIP\u30A2\u30C9\u30EC\u30B9</b>
      \u3068\u3001\u793E\u54E1\u8A73\u7D30\u306E <b>\u300C\u7AEF\u672BIP\u300D</b>
      \u3092\u898B\u6BD4\u3079\u307E\u3059\u3002\n\u30FB\u63A5\u7D9A\u8981\u6C42\u306E\u300C\u63A5\u7D9A\u5143\u300D\u306E\u62EC\u5F27\u5185\u304C
      IP\u30A2\u30C9\u30EC\u30B9\u3067\u3059\uFF08\u4F8B: \u793E\u5185 (10.10.2.12)\uFF09\u3002\n\u30FB\u793E\u54E1\u8A73\u7D30\u306E\u300C\u7AEF\u672BIP\u300D\u3068
      <color=#B00000><b>\u9055\u3048\u3070\u3001\u7AEF\u672B\u540D\u3092\u507D\u3063\u305F
      \u306A\u308A\u3059\u307E\u3057</b></color> \u3067\u3059\u3002\u62D2\u5426\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - title: "\u52E4\u52D9\u72B6\u614B"
    requiredFeature: WORK_STATUS
    text: "\u793E\u54E1\u60C5\u5831\u306E <b>\u300C\u52E4\u52D9\u72B6\u614B\u300D</b>
      \u304C <color=#B00000><b>\u300C\u9000\u52E4\u300D</b></color> \u306E\u793E\u54E1\u304B\u3089\u306E\u63A5\u7D9A\u306F\u62D2\u5426\u3057\u307E\u3059\u3002\n\u30FB\u5E30\u5B85\u3057\u305F\u793E\u54E1\u306EID\u304C\u4F7F\u308F\u308C\u3066\u3044\u308B\u5834\u5408\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u76D7\u307E\u308C\u3066\u3044\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002"
  - title: "\u63A5\u7D9A\u5143\u306E\u906E\u65AD"
    requiredFeature: FIREWALL_BLOCK
    text: "\u540C\u3058\u63A5\u7D9A\u5143\u304B\u3089 <b>\u30ED\u30B0\u30A4\u30F3\u5931\u6557\uFF08AUTH
      / FAIL\uFF09</b> \u304C\u7D9A\u304F\u5834\u5408\u306F\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u7DCF\u5F53\u305F\u308A\u653B\u6483\u3067\u3059\u3002\n\u30FB\u63A5\u7D9A\u76E3\u8996\u3067\u8981\u6C42\u3092\u9078\u3073
      <color=#8A4B00><b>[\u63A5\u7D9A\u5143\u3092\u906E\u65AD]</b></color> \u3092\u62BC\u3059\u3068\u3001\u305D\u306E\u63A5\u7D9A\u5143\u304B\u3089\u306E\u901A\u4FE1\u3092\u30D5\u30A1\u30A4\u30A2\u30A6\u30A9\u30FC\u30EB\u3067\u6B62\u3081\u307E\u3059\u3002\n\u30FB\u906E\u65AD\u3057\u305F\u63A5\u7D9A\u5143\u304B\u3089\u306E\u8981\u6C42\u306F\u81EA\u52D5\u7684\u306B\u62D2\u5426\u3055\u308C\u307E\u3059\u3002<color=#B00000><b>\u793E\u5185\u306E\u7AEF\u672B\u3084\u6B63\u898F\u306E\u793E\u54E1\u306E\u63A5\u7D9A\u5143\u306F\u906E\u65AD\u3057\u306A\u3044\u3053\u3068\u3002</b></color>"
  - title: "\u5728\u7C4D\u72B6\u614B"
    requiredFeature: EMPLOYMENT_STATUS
    text: "\u793E\u54E1\u60C5\u5831\u306E <b>\u300C\u5728\u7C4D\u72B6\u614B\u300D</b>
      \u304C <b>\u300C\u5728\u7C4D\u300D</b> \u3067\u306A\u3044\u793E\u54E1\uFF08<color=#B00000><b>\u4F11\u8077\u30FB\u9000\u8077</b></color>\uFF09\u304B\u3089\u306E\u63A5\u7D9A\u306F\u62D2\u5426\u3057\u307E\u3059\u3002\n\u30FB\u9000\u8077\u3057\u305F\u793E\u54E1\u306EID\u304C\u7121\u52B9\u306B\u3055\u308C\u305A\u6B8B\u3063\u3066\u3044\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002"
  - title: "\u5831\u544A"
    requiredFeature: REPORT
    text: "\u602A\u3057\u3044\u30E1\u30FC\u30EB\u30FB\u4E0D\u5BE9\u306A\u52D5\u304D\u3092\u898B\u3064\u3051\u305F\u3089
      <color=#8A4B00><b>[\u5831\u544A]</b></color> \u3067\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8\u306B\u77E5\u3089\u305B\u307E\u3059\u3002\n\u30FB\u30E1\u30FC\u30EB\u306E
      <b>\u5DEE\u51FA\u4EBA\u306E\u30A2\u30C9\u30EC\u30B9</b> \u304C\u793E\u5185\uFF08@nexus-corp.example\uFF09\u3068\u9055\u3046\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u5165\u529B\u3092\u6C42\u3081\u308B
      \u2192 \u5165\u529B\u305B\u305A\u306B\u5831\u544A\u3002\n\u30FB\u5831\u544A\u306F\u8A55\u4FA1\u306B\u52A0\u308F\u308A\u307E\u3059\u3002\u4F55\u3067\u3082\u5831\u544A\u3059\u308C\u3070\u3088\u3044\u308F\u3051\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
  - title: "\u81EA\u5206\u306EID\u306E\u4E0D\u6B63\u5229\u7528"
    requiredFeature: REPORT
    text: "\u63A5\u7D9A\u8981\u6C42\u306E\u5229\u7528\u8005\u304C <b>\u81EA\u5206\u306EID</b>
      \u3067\u3001\u81EA\u5206\u306E\u5E2D\u3067\u306F\u306A\u3044\u7AEF\u672B\u304B\u3089\u306E\u8981\u6C42\u306F
      <color=#B00000><b>\u62D2\u5426</b></color>\u3002\n\u30FB\u3059\u3050\u306B
      [\u30E1\u30A4\u30F3\u30E1\u30CB\u30E5\u30FC] \u2192 [\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u5909\u66F4]
      \u3067 <b>\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5909\u66F4</b> \u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30FB<color=#B00000><b>\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u4ED8\u7B8B\u306B\u66F8\u3044\u3066\u3044\u308B\u3068\u3001\u72D9\u308F\u308C\u3084\u3059\u304F\u306A\u308A\u307E\u3059\u3002</b></color>"
