%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a728b0253e65334ca61413bf0408212, type: 3}
  m_Name: DOC_SYSTEM_MANUAL
  m_EditorClassIdentifier: 
  documentId: SYSTEM_MANUAL
  title: "\u793E\u5185\u60C5\u5831\u30B7\u30B9\u30C6\u30E0 \u64CD\u4F5C\u30DE\u30CB\u30E5\u30A2\u30EB\uFF08\u591C\u9593\u904B\u7528\u62C5\u5F53\u5411\u3051\uFF09"
  fileName: "\u696D\u52D9\u30B7\u30B9\u30C6\u30E0\u64CD\u4F5C\u30DE\u30CB\u30E5\u30A2\u30EB.doc"
  icon: doc
  requiredFeature: 
  body: "\u672C\u66F8\u306F\u793E\u5185\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u306E\u64CD\u4F5C\u65B9\u6CD5\u3092\u307E\u3068\u3081\u305F\u3082\u306E\u3067\u3059\u3002\u62C5\u5F53\u7BC4\u56F2\u304C\u5E83\u304C\u308B\u3068\u3001\u7AE0\u304C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002"
  sections:
  - requiredFeature: CONNECTION_MONITOR
    text: "<b>\u25A0 \u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A\u76E3\u8996\uFF08\u63A5\u7D9A\u8981\u6C42\u306E\u5BE9\u67FB\uFF09</b>\n\u793E\u5185\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u3078\u306E\u63A5\u7D9A\u8981\u6C42\u304C\u5C4A\u304F\u3068\u3001\u753B\u9762\u53F3\u4E0B\u306B\u901A\u77E5\u304C\u8868\u793A\u3055\u308C\u307E\u3059\u3002\u4E00\u89A7\u304B\u3089\u8981\u6C42\u3092\u9078\u3073\u3001\u5185\u5BB9\u3092\u78BA\u8A8D\u3057\u3066\u304B\u3089\u51E6\u7406\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30FB<color=#0030A0><b>\u63A5\u7D9A\u3092\u8A31\u53EF(A)</b></color>
      / <color=#B00000><b>\u63A5\u7D9A\u3092\u62D2\u5426(B)</b></color> \u2026 \u9078\u629E\u4E2D\u306E\u8981\u6C42\u3092\u51E6\u7406\u3057\u307E\u3059\u3002<b>\u51E6\u7406\u5F8C\u306E\u53D6\u308A\u6D88\u3057\u306F\u3067\u304D\u307E\u305B\u3093\u3002</b>\n\u30FB\u793E\u54E1\u60C5\u5831\u3092\u53C2\u7167(R)
      \u2026 \u5229\u7528\u8005\u306E\u793E\u54E1\u756A\u53F7\uFF08\u307E\u305F\u306F\u7AEF\u672B\u756A\u53F7\uFF09\u3067\u793E\u54E1\u60C5\u5831\u3092\u691C\u7D22\u3057\u307E\u3059\u3002\n\u30FB\u8981\u6C42\u306B\u306F
      <b>\u53D7\u4ED8\u304B\u3089\u306E\u671F\u9650</b> \u304C\u3042\u308A\u307E\u3059\u3002\u671F\u9650\u3092\u904E\u304E\u305F\u8981\u6C42\u306F\u81EA\u52D5\u7684\u306B\u7834\u68C4\u3055\u308C\u307E\u3059\u3002\n\u30FB\u78BA\u8A8D\u3059\u308B\u9805\u76EE:
      \u5229\u7528\u8005 / \u793E\u54E1\u756A\u53F7 / \u7AEF\u672B / \u63A5\u7D9A\u5143\uFF08\u793E\u5185\u30FB\u793E\u5916\uFF09
      / \u63A5\u7D9A\u5148 / \u63A5\u7D9A\u7A2E\u5225"
  - requiredFeature: EMPLOYEE_DIRECTORY
    text: "<b>\u25A0 \u793E\u54E1\u60C5\u5831\u306E\u691C\u7D22\u30FB\u53C2\u7167</b>\n\u793E\u54E1\u756A\u53F7\u30FB\u6C0F\u540D\u30FB\u90E8\u7F72\u30FB\u7AEF\u672B\u756A\u53F7\u3067\u691C\u7D22\u3067\u304D\u307E\u3059\uFF08\u90E8\u5206\u4E00\u81F4\uFF09\u3002\u30C0\u30D6\u30EB\u30AF\u30EA\u30C3\u30AF\u307E\u305F\u306F
      [\u8A73\u7D30\u8868\u793A] \u3067\u8A73\u7D30\u3092\u8868\u793A\u3057\u307E\u3059\u3002\n\u30FB<b>\u767B\u9332\u7AEF\u672B</b>
      \u2026 \u305D\u306E\u793E\u54E1\u306B\u5272\u308A\u5F53\u3066\u3089\u308C\u305FPC\u3002<b>VPN\u7AEF\u672B</b>
      \u306F\u793E\u5916\u63A5\u7D9A\u7528\u306E\u767B\u9332\u30CE\u30FC\u30C8PC\u3067\u3059\u3002\n\u30FB<color=#B00000><b>\u8A72\u5F53\u3059\u308B\u793E\u54E1\u304C\u898B\u3064\u304B\u3089\u306A\u3044</b></color>
      \u5834\u5408\u3001\u305D\u306E\u5229\u7528\u8005\u30FB\u7AEF\u672B\u306F\u793E\u54E1\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002\n\u30FB<b>\u30B7\u30B9\u30C6\u30E0\u5229\u7528\u6A29\u9650
      / \u7BA1\u7406\u8005\u6A29\u9650</b> \u2026 \u25CB \u306F\u6A29\u9650\u3042\u308A\u3001\xD7
      \u306F\u6A29\u9650\u306A\u3057\u3002\n\u30FB<b>\u901A\u5E38\u5229\u7528\u30B7\u30B9\u30C6\u30E0</b>
      \u2026 \u305D\u306E\u793E\u54E1\u304C\u666E\u6BB5\u4F7F\u3046\u30B7\u30B9\u30C6\u30E0\u3002<color=#8A4B00><b>\u6A29\u9650\u3068\u306F\u5225\u306E\u60C5\u5831</b></color>
      \u3067\u3059\u3002"
  - requiredFeature: HELPDESK
    text: "<b>\u25A0 IT\u30B5\u30DD\u30FC\u30C8\u53D7\u4ED8\u7BA1\u7406</b>\n\u30FB<b>\u76F8\u8AC7</b>
      \u2026 \u793E\u54E1\u304B\u3089\u306E\u8CEA\u554F\u3067\u3059\u3002\u56DE\u7B54\u3092\u9078\u3093\u3067
      [\u56DE\u7B54\u3092\u9001\u4FE1(S)] \u3057\u307E\u3059\u3002\n\u30FB<b>\u969C\u5BB3</b>
      \u2026 \u793E\u54E1PC\u306E\u4E0D\u5177\u5408\u3067\u3059\u3002[\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A(R)]
      \u3067\u793E\u54E1PC\u3092\u64CD\u4F5C\u3057\u3001\u76F4\u3063\u305F\u3053\u3068\u3092\u78BA\u8A8D\u3057\u3066\u304B\u3089
      [\u5BFE\u5FDC\u5B8C\u4E86\u3092\u5831\u544A(P)] \u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30FB<color=#B00000><b>\u30EA\u30E2\u30FC\u30C8\u63A5\u7D9A\u4E2D\u3082\u696D\u52D9\u6642\u9593\u306F\u9032\u307F\u307E\u3059\u3002</b></color>
      \u4ED6\u306E\u696D\u52D9\u304C\u5165\u3063\u305F\u3089\u3001\u3044\u3063\u305F\u3093\u4E2D\u65AD\u3057\u3066\u623B\u3063\u3066\u304D\u3066\u3082\u69CB\u3044\u307E\u305B\u3093\u3002"
  - requiredFeature: SYSTEM_LOG
    text: "<b>\u25A0 \u30B7\u30B9\u30C6\u30E0\u30ED\u30B0\u306E\u691C\u7D22\u30FB\u53C2\u7167</b>\n\u793E\u5185\u30B7\u30B9\u30C6\u30E0\u306E\u4E3B\u306A\u901A\u4FE1\u30FB\u51E6\u7406\u306E\u8A18\u9332\u3067\u3059\u3002\u30AD\u30FC\u30EF\u30FC\u30C9\uFF08IP\u30A2\u30C9\u30EC\u30B9\u3001\u30B5\u30FC\u30D0\u30FC\u540D\u3001\u5229\u7528\u8005\u306A\u3069\uFF09\u3068\u7A2E\u5225\u3067\u7D5E\u308A\u8FBC\u3081\u307E\u3059\u3002\n\u30FB\u884C\u3092\u30C0\u30D6\u30EB\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u3001\u305D\u306E\u63A5\u7D9A\u5143\u3067\u7D5E\u308A\u8FBC\u307F\u307E\u3059\u3002\n\u30FB\u30ED\u30B0\u306F\u81EA\u52D5\u3067\u306F\u5206\u6790\u3055\u308C\u307E\u305B\u3093\u3002<b>\u540C\u3058\u63A5\u7D9A\u5143\u30FB\u540C\u3058\u6642\u9593\u5E2F\u306E\u8A18\u9332</b>
      \u306B\u6CE8\u76EE\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - requiredFeature: NETWORK_MAP
    text: "<b>\u25A0 \u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u30DE\u30C3\u30D7</b>\n\u901A\u4FE1\u306E\u6D41\u308C\uFF08\u63A5\u7D9A\u5143
      \u2192 \u63A5\u7D9A\u5148\uFF09\u3092\u8868\u793A\u3057\u307E\u3059\u3002\u30B5\u30FC\u30D0\u30FC\u306F\u76E3\u8996\u306E\u307F\u3067\u3001\u64CD\u4F5C\u306F\u3067\u304D\u307E\u305B\u3093\u3002"
  - requiredFeature: 
    text: "<b>\u25A0 \u30AD\u30FC\u30DC\u30FC\u30C9\u64CD\u4F5C</b>\n\u30FB\u30A6\u30A3\u30F3\u30C9\u30A6\u5207\u66FF:
      Ctrl+Tab / Alt+PageUp\u3000\u30FB\u30A6\u30A3\u30F3\u30C9\u30A6\u3092\u9589\u3058\u308B:
      Ctrl+F4\u3000\u30FB\u4E00\u6642\u505C\u6B62: Esc\n\u30FB\u696D\u52D9\u30E1\u30CB\u30E5\u30FC\u306E\u5404\u30B7\u30B9\u30C6\u30E0\u306F\u3001\u30E1\u30A4\u30F3\u30E1\u30CB\u30E5\u30FC\u3067
      1\u301C7 \u306E\u30AD\u30FC\u3067\u3082\u958B\u3051\u307E\u3059\u3002"
  - requiredFeature: REMOTE_SUPPORT
    text: "<b>\u25A0 \u30EA\u30E2\u30FC\u30C8PC\u306E\u30AD\u30FC\u30DC\u30FC\u30C9\u64CD\u4F5C</b>\n\u30FB\u30B9\u30BF\u30FC\u30C8
      Alt+Home / \u30D5\u30A1\u30A4\u30EB\u540D\u3092\u6307\u5B9A\u3057\u3066\u5B9F\u884C
      Ctrl+Alt+R / \u30A8\u30AF\u30B9\u30D7\u30ED\u30FC\u30E9\u30FC Ctrl+Alt+E\n\u30FB\u8A2D\u5B9A
      Ctrl+Alt+I / \u30C7\u30B9\u30AF\u30C8\u30C3\u30D7 Ctrl+Alt+D / \u30BF\u30B9\u30AF
      \u30DE\u30CD\u30FC\u30B8\u30E3\u30FC Ctrl+Alt+End / \u66F4\u65B0 F5\n\uFF08Windows
      \u30AD\u30FC\u3084 Alt+Tab \u306F\u624B\u5143\u306EPC\u304C\u51E6\u7406\u3059\u308B\u305F\u3081\u3001\u4E0A\u8A18\u306E\u4EE3\u66FF\u30AD\u30FC\u3092\u4F7F\u3063\u3066\u304F\u3060\u3055\u3044\uFF09"
