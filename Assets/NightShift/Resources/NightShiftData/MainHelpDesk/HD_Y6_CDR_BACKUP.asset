  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u66F8\u304D\u63DB\u3048\u3067\u304D\u306A\u3044\u5A92\u4F53\u306A\u3089\u3001\u8EAB\u4EE3\u91D1\u30A6\u30A4\u30EB\u30B9\u306B\u6697\u53F7\u5316\u3055\u308C\u307E\u305B\u3093\u3002"
  incorrectOption: "\u3044\u3044\u3048\u3002\u5171\u6709\u30D5\u30A9\u30EB\u30C0\u306B\u7F6E\u3051\u3070\u5341\u5206\u3067\u3059\u3002"
