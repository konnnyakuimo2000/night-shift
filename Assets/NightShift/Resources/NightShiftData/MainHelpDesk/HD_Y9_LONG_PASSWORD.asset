  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u9577\u304F\u3001\u6587\u5B57\u306E\u7A2E\u985E\u304C\u591A\u3044\u307B\u3069\u7DCF\u5F53\u305F\u308A\u3067\u7834\u3089\u308C\u306B\u304F\u304F\u306A\u308A\u307E\u3059\u3002"
  incorrectOption: "\u3044\u3044\u3048\u3002\u899A\u3048\u3089\u308C\u306A\u3044\u306E\u3067\u77ED\u3044\u6570\u5B57\u306B\u623B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  replyAfterAnswer: "\u3088\u304B\u3063\u305F\u3067\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u7DCF\u5F53\u305F\u308A\u653B\u6483\u3078\u306E\u5BFE\u7B56\u306F\u3001\u9577\u304F\u6587\u5B57\u306E\u7A2E\u985E\u306E\u591A\u3044\u30D1\u30B9\u30EF\u30FC\u30C9\u3002"
