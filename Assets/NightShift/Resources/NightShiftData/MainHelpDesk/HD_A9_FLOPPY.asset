  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u8A18\u61B6\u5A92\u4F53\u304B\u3089\u3082\u611F\u67D3\u3057\u307E\u3059\u3002\u4F7F\u3046\u524D\u306B\u30A6\u30A4\u30EB\u30B9\u691C\u67FB\u3092\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u6DFB\u4ED8\u30D5\u30A1\u30A4\u30EB\u3067\u306A\u3051\u308C\u3070\u611F\u67D3\u3057\u307E\u305B\u3093\u3002"
