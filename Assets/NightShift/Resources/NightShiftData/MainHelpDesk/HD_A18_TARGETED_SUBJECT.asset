  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u77E5\u3089\u306A\u3044\u5DEE\u51FA\u4EBA\u304B\u3089\u3001\u79C1\u306E\u62C5\u5F53\u696D\u52D9\u306B\u3074\u3063\u305F\u308A\u306E\u4EF6\u540D\u306E\u30E1\u30FC\u30EB\u304C\u6765\u307E\u3057\u305F\u3002\u8FF7\u60D1\u30E1\u30FC\u30EB\u3063\u307D\u304F\u306A\u3044\u304B\u3089\u5B89\u5168\u3067\u3059\u3088\u306D\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u696D\u52D9\u306B\u95A2\u4FC2\u3042\u308A\u305D\u3046\u306A\u5185\u5BB9\u3053\u305D\u6A19\u7684\u578B\u653B\u6483\u30E1\u30FC\u30EB\u306E\u7279\u5FB4\u3067\u3059\u3002\u958B\u304F\u524D\u306B\u5831\u544A\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u5E83\u544A\u3063\u307D\u304F\u306A\u3044\u306E\u3067\u5B89\u5168\u3067\u3059\u3002"
  replyAfterAnswer: "\u5371\u306A\u304B\u3063\u305F\u2026\u5831\u544A\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
