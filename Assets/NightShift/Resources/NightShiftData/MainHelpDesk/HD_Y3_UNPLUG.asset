  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u3059\u3050\u306B\u629C\u3044\u3066\u3001\u96FB\u6E90\u306F\u305D\u306E\u307E\u307E\u306B\u3057\u3066\u5F85\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
