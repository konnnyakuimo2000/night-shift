  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u793E\u5185\u306E\u8907\u5408\u6A5F\u304B\u3089\u300C\u30B9\u30AD\u30E3\u30F3\u3057\u305F\u30D5\u30A1\u30A4\u30EB\u300D\u3068\u3044\u3046\u30E1\u30FC\u30EB\u304C\u5C4A\u304D\u307E\u3057\u305F\u3002\u79C1\u306F\u30B9\u30AD\u30E3\u30F3\u3057\u3066\u3044\u306A\u3044\u3093\u3067\u3059\u304C\u3001\u793E\u5185\u306E\u6A5F\u68B0\u304B\u3089\u306A\u306E\u3067\u958B\u3044\u3066\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u958B\u304B\u305A\u306B\u5831\u544A\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u8907\u5408\u6A5F\u306E\u6C7A\u307E\u3063\u305F\u5DEE\u51FA\u4EBA\u30FB\u4EF6\u540D\u3092\u771F\u4F3C\u305F\u507D\u30E1\u30FC\u30EB\u306E\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002"
  incorrectOption: "\u306F\u3044\u3002\u793E\u5185\u306E\u8907\u5408\u6A5F\u304B\u3089\u306A\u306E\u3067\u958B\u3044\u3066\u5927\u4E08\u592B\u3067\u3059\u3002"
  replyAfterAnswer: "\u958B\u304B\u305A\u306B\u5831\u544A\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u521D\u671F\u8A2D\u5B9A\u306E\u307E\u307E\u306E\u5DEE\u51FA\u4EBA\u3084\u4EF6\u540D\u306F\u8AB0\u3067\u3082\u771F\u4F3C\u3067\u304D\u308B\u3002\u8EAB\u306B\u899A\u3048\u306E\u306A\u3044\u30E1\u30FC\u30EB\u306F\u958B\u304B\u306A\u3044\u3002"
