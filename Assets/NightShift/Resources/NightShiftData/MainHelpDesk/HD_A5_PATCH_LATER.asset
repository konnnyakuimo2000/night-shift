  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u300C\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0\u3092\u9069\u7528\u3057\u3066\u304F\u3060\u3055\u3044\u300D\u3068\u6BCE\u65E5\u51FA\u307E\u3059\u3002\u4ECA\u306E\u307E\u307E\u3067\u56F0\u3063\u3066\u3044\u306A\u3044\u306E\u3067\u3001\u9069\u7528\u3057\u306A\u304F\u3066\u3044\u3044\u3067\u3059\u3088\u306D\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u30A6\u30A4\u30EB\u30B9\u611F\u67D3\u306E\u4E88\u9632\u306E\u305F\u3081\u3001\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0\u306F\u9069\u7528\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u56F0\u3063\u3066\u3044\u306A\u3051\u308C\u3070\u9069\u7528\u3057\u306A\u304F\u3066\u5927\u4E08\u592B\u3067\u3059\u3002"
  replyAfterAnswer: "\u4E86\u89E3\u3067\u3059\u3001\u5165\u308C\u3066\u304A\u304D\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u4FEE\u6B63\u30D7\u30ED\u30B0\u30E9\u30E0\u306F\u3001\u30BD\u30D5\u30C8\u306E\u5F31\u70B9\uFF08\u8106\u5F31\u6027\uFF09\u3092\u3075\u3055\u3050\u305F\u3081\u306E\u3082\u306E\u3002\u9069\u7528\u3057\u306A\u3044\u3068\u3001\u305D\u306E\u5F31\u70B9\u3092\u72D9\u3063\u305F\u653B\u6483\u3092\u53D7\u3051\u308B\u3002"
