  subject: "\u5168\u753B\u9762\u306E\u8B66\u544A\u3068\u30B5\u30DD\u30FC\u30C8\u306E\u96FB\u8A71\u756A\u53F7"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\nWeb\u3092\u898B\u3066\u3044\u305F\u3089\u300C\u30A6\u30A4\u30EB\u30B9\u306B\u611F\u67D3\u3057\u3066\u3044\u307E\u3059\u300D\u3068\u5168\u753B\u9762\u306B\u51FA\u3066\u3001\u30B5\u30DD\u30FC\u30C8\u306E\u96FB\u8A71\u756A\u53F7\u304C\u8868\u793A\u3055\u308C\u307E\u3057\u305F\u3002\u30A6\u30A4\u30EB\u30B9\u5BFE\u7B56\u30BD\u30D5\u30C8\u306E\u30ED\u30B4\u3082\u4ED8\u3044\u3066\u3044\u307E\u3059\u3002\u96FB\u8A71\u3057\u3066\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u753B\u9762\u306E\u6307\u793A\u306B\u306F\u5F93\u308F\u305A\u3001\u30D6\u30E9\u30A6\u30B6\u3092\u9589\u3058\u3066\u304F\u3060\u3055\u3044\u3002\u96FB\u8A71\u3082\u30C4\u30FC\u30EB\u306E\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u3082\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u30ED\u30B4\u304C\u672C\u7269\u306A\u306E\u3067\u3001\u8868\u793A\u3055\u308C\u305F\u756A\u53F7\u306B\u96FB\u8A71\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  replyAfterAnswer: "\u9589\u3058\u307E\u3057\u305F\u3002\u96FB\u8A71\u3057\u306A\u304F\u3066\u3088\u304B\u3063\u305F\u2026\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u507D\u306E\u8B66\u544A\u3067\u4E0D\u5B89\u3092\u3042\u304A\u308A\u3001\u96FB\u8A71\u3055\u305B\u305F\u308A\u30C4\u30FC\u30EB\u3092\u5165\u308C\u3055\u305B\u305F\u308A\u3059\u308B\u624B\u53E3\uFF08\u30B5\u30DD\u30FC\u30C8\u8A50\u6B3A\uFF09\u3002\u30ED\u30B4\u306F\u7C21\u5358\u306B\u771F\u4F3C\u3067\u304D\u308B\u3002"
  sourceNote: "\u4EE4\u548C6\u5E74\u5EA6 \u60C5\u5831\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u30DE\u30CD\u30B8\u30E1\u30F3\u30C8\u8A66\u9A13
