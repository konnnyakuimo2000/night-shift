  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u30A6\u30A4\u30EB\u30B9\u611F\u67D3\u306E\u4E88\u9632\u306E\u305F\u3081\u3001\u3059\u3050\u306B\u9069\u7528\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u3044\u3044\u3048\u3002\u52D5\u4F5C\u304C\u5909\u308F\u308B\u3068\u56F0\u308B\u306E\u3067\u3001\u56F0\u308B\u307E\u3067\u9069\u7528\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002"
