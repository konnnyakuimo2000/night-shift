  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u8868\u793A\u3055\u308C\u305F\u756A\u53F7\u306B\u96FB\u8A71\u3057\u305F\u308A\u3001\u30C4\u30FC\u30EB\u3092\u5165\u308C\u305F\u308A\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u3044\u3044\u3048\u3002\u8868\u793A\u3055\u308C\u305F\u30B5\u30DD\u30FC\u30C8\u306B\u96FB\u8A71\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
