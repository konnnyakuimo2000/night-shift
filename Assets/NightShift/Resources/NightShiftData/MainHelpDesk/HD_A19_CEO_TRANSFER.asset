  subject: "\u793E\u9577\u304B\u3089\u81F3\u6025\u306E\u632F\u8FBC\u4F9D\u983C"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u793E\u9577\u306E\u30A2\u30C9\u30EC\u30B9\u304B\u3089\u300C\u81F3\u6025\u3053\u306E\u53E3\u5EA7\u306B\u632F\u308A\u8FBC\u3093\u3067\u300D\u3068\u30E1\u30FC\u30EB\u304C\u6765\u307E\u3057\u305F\u3002\u30A2\u30C9\u30EC\u30B9\u306F\u672C\u7269\u306B\u3057\u304B\u898B\u3048\u307E\u305B\u3093\u3002\u632F\u308A\u8FBC\u3093\u3067\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u30A2\u30C9\u30EC\u30B9\u306F\u7C21\u5358\u306B\u507D\u308C\u307E\u3059\u3002\u793E\u9577\u672C\u4EBA\u306B\u3001\u30E1\u30FC\u30EB\u4EE5\u5916\u306E\u65B9\u6CD5\u3067\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u30A2\u30C9\u30EC\u30B9\u304C\u672C\u7269\u306A\u3089\u672C\u7269\u306E\u30E1\u30FC\u30EB\u3067\u3059\u3002"
  replyAfterAnswer: "\u793E\u9577\u5BA4\u306B\u96FB\u8A71\u3057\u3066\u307F\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u5DEE\u51FA\u4EBA\u306E\u30A2\u30C9\u30EC\u30B9\u306F\u507D\u88C5\u3067\u304D\u308B\u3002\u9001\u4FE1\u5143\u306E\u30B5\u30FC\u30D0\u30FC\u3092\u78BA\u304B\u3081\u3001\u672C\u4EBA\u306B\u5225\u306E\u65B9\u6CD5\u3067\u78BA\u8A8D\u3059\u308B\u3002"
