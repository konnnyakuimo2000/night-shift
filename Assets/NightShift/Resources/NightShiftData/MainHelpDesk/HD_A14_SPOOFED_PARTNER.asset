  subject: "\u53D6\u5F15\u5148\u3092\u540D\u4E57\u308B\u30E1\u30FC\u30EB\u306E\u6DFB\u4ED8\u3092\u958B\u3044\u3066\u3057\u307E\u3063\u305F"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u53D6\u5F15\u5148\u306E\u62C5\u5F53\u8005\u304B\u3089\u306E\u30E1\u30FC\u30EB\u306E\u6DFB\u4ED8\u3092\u958B\u304D\u307E\u3057\u305F\u3002\u3042\u3068\u3067\u672C\u4EBA\u306B\u805E\u3044\u305F\u3089\u300C\u9001\u3063\u3066\u3044\u306A\u3044\u300D\u3068\u3002PC\u306B\u7570\u5E38\u306F\u306A\u3044\u306E\u3067\u3001\u3082\u3046\u4E00\u5EA6\u6DFB\u4ED8\u3092\u958B\u3044\u3066\u78BA\u304B\u3081\u3066\u3082\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u5909\u66F4\u3092\u4F9D\u983C\u3057\u3001PC\u306F\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u304B\u3089\u5207\u308A\u96E2\u3057\u3066\u6301\u3063\u3066\u304D\u3066\u304F\u3060\u3055\u3044\u3002\u5B9A\u7FA9\u30D5\u30A1\u30A4\u30EB\u3092\u6700\u65B0\u306B\u3057\u3066\u5168\u4F53\u3092\u691C\u67FB\u3057\u307E\u3059\u3002"
  incorrectOption: "\u306F\u3044\u3002\u3082\u3046\u4E00\u5EA6\u958B\u3044\u3066\u3001\u7570\u5E38\u304C\u51FA\u308B\u304B\u78BA\u304B\u3081\u3066\u304F\u3060\u3055\u3044\u3002"
  replyAfterAnswer: "\u308F\u304B\u308A\u307E\u3057\u305F\u3001\u30B1\u30FC\u30D6\u30EB\u3092\u629C\u3044\u3066\u6301\u3063\u3066\u3044\u304D\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u611F\u67D3\u306E\u53EF\u80FD\u6027\u304C\u3042\u308B\u5834\u5408\u306F\u5207\u308A\u96E2\u3057\u3066\u691C\u67FB\u3057\u3001\u8A8D\u8A3C\u60C5\u5831\u3082\u5909\u3048\u308B\u3002\u3082\u3046\u4E00\u5EA6\u958B\u304F\u306E\u306F\u88AB\u5BB3\u3092\u5E83\u3052\u308B\u3060\u3051\u3002"
  sourceNote: "\u60C5\u5831\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u30DE\u30CD\u30B8\u30E1\u30F3\u30C8\u8A66\u9A13
    \u79D1\u76EEB \u30B5\u30F3\u30D7\u30EB\u554F\u984C\uFF082022\u5E744\u6708\u516C\u958B\uFF09\u554F3\uFF08\u6539\u5909\uFF09"
