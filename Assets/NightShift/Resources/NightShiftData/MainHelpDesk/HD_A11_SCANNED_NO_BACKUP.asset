  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u5927\u4E8B\u306A\u30D5\u30A1\u30A4\u30EB\u306F\u30A6\u30A4\u30EB\u30B9\u5BFE\u7B56\u30BD\u30D5\u30C8\u3067\u5168\u90E8\u691C\u67FB\u3057\u307E\u3057\u305F\u3002\u554F\u984C\u306A\u304B\u3063\u305F\u306E\u3067\u3001\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u306F\u3082\u3046\u3044\u3089\u306A\u3044\u3067\u3059\u3088\u306D\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u5B9A\u671F\u7684\u306B\u5916\u90E8\u306E\u8A18\u9332\u5A92\u4F53\u3078\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u3057\u3001\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u304B\u3089\u5207\u308A\u96E2\u3057\u3066\u4FDD\u7BA1\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u691C\u67FB\u3067\u554F\u984C\u304C\u306A\u3051\u308C\u3070\u3001\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u306F\u3044\u308A\u307E\u305B\u3093\u3002"
  replyAfterAnswer: "\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u3092\u53D6\u3063\u3066\u304A\u304D\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u691C\u67FB\u306F\u3001\u305D\u306E\u6642\u70B9\u3067\u554F\u984C\u304C\u306A\u3044\u3068\u5206\u304B\u308B\u3060\u3051\u3002\u8EAB\u4EE3\u91D1\u30A6\u30A4\u30EB\u30B9\u5BFE\u7B56\u306E\u57FA\u672C\u306F\u3001\u5207\u308A\u96E2\u3057\u3066\u4FDD\u7BA1\u3059\u308B\u30D0\u30C3\u30AF\u30A2\u30C3\u30D7\u3002"
  sourceNote: "\u4EE4\u548C4\u5E74\u5EA6 IT\u30D1\u30B9\u30DD\u30FC\u30C8\u8A66\u9A13
