  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u7DCF\u5F53\u305F\u308A\u3067\u8A66\u3055\u308C\u308B\u3068\u3059\u3050\u7834\u3089\u308C\u307E\u3059\u3002\u9577\u304F\u3001\u6587\u5B57\u306E\u7A2E\u985E\u3092\u6DF7\u305C\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u4ED6\u4EBA\u306B\u5206\u304B\u3089\u306A\u3051\u308C\u3070\u77ED\u304F\u3066\u3082\u5927\u4E08\u592B\u3067\u3059\u3002"
