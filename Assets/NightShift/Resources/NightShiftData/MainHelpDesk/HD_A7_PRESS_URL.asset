  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u65B0\u805E\u793E\u3092\u540D\u4E57\u308B\u30D5\u30EA\u30FC\u30E1\u30FC\u30EB\u306E\u30A2\u30C9\u30EC\u30B9\u304B\u3089\u53D6\u6750\u4F9D\u983C\u304C\u6765\u307E\u3057\u305F\u3002\u672C\u6587\u306EURL\u3092\u958B\u304F\u3088\u3046\u66F8\u3044\u3066\u3042\u308A\u307E\u3059\u3002\u958B\u3044\u3066\u78BA\u8A8D\u3057\u3066\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002URL\u306F\u958B\u304B\u305A\u3001\u60C5\u5831\u30B7\u30B9\u30C6\u30E0\u90E8\u306B\u5831\u544A\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u958B\u3044\u3066\u5185\u5BB9\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  replyAfterAnswer: "\u958B\u304B\u305A\u306B\u5831\u544A\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u7279\u5B9A\u306E\u76F8\u624B\u3092\u72D9\u3044\u3001\u8208\u5473\u3092\u5F15\u304F\u6587\u9762\u3067\u30A6\u30A4\u30EB\u30B9\u4ED8\u304D\u306EURL\u3084\u6DFB\u4ED8\u3092\u958B\u304B\u305B\u308B\u624B\u53E3\uFF08\u6A19\u7684\u578B\u653B\u6483\uFF09\u3002"
