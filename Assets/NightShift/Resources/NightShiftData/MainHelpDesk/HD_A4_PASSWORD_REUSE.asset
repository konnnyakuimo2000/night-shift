  subject: "\u4F1A\u54E1\u30B5\u30A4\u30C8\u304B\u3089\u60C5\u5831\u6F0F\u3048\u3044\u306E\u304A\u77E5\u3089\u305B"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u3088\u304F\u4F7F\u3046\u4F1A\u54E1\u30B5\u30A4\u30C8\u304B\u3089\u300C\u60C5\u5831\u304C\u6F0F\u308C\u305F\u300D\u3068\u901A\u77E5\u304C\u6765\u307E\u3057\u305F\u3002\u793E\u5185\u3068\u540C\u3058\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u4F7F\u3063\u3066\u3044\u308B\u3093\u3067\u3059\u304C\u3001\u793E\u5185\u306F\u95A2\u4FC2\u306A\u3044\u3067\u3059\u3088\u306D\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u793E\u5185\u306E\u30D1\u30B9\u30EF\u30FC\u30C9\u3082\u3059\u3050\u306B\u5909\u3048\u3066\u3001\u30B5\u30A4\u30C8\u3054\u3068\u306B\u5225\u306E\u30D1\u30B9\u30EF\u30FC\u30C9\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u6F0F\u308C\u305F\u306E\u306F\u305D\u306E\u30B5\u30A4\u30C8\u306A\u306E\u3067\u3001\u793E\u5185\u306F\u95A2\u4FC2\u3042\u308A\u307E\u305B\u3093\u3002"
  replyAfterAnswer: "\u3059\u3050\u5909\u3048\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u3042\u308B\u30B5\u30A4\u30C8\u304B\u3089\u6F0F\u308C\u305FID\u3068\u30D1\u30B9\u30EF\u30FC\u30C9\u3067\u3001\u5225\u306E\u30B5\u30A4\u30C8\u306B\u4E0D\u6B63\u30ED\u30B0\u30A4\u30F3\u3059\u308B\u624B\u53E3\uFF08\u30D1\u30B9\u30EF\u30FC\u30C9\u30EA\u30B9\u30C8\u653B\u6483\uFF09\u304C\u3042\u308B\u3002\u4F7F\u3044\u56DE\u3057\u306F\u5371\u967A\u3002"
