  subject: "\u632F\u8FBC\u5148\u306E\u53E3\u5EA7\u304C\u5909\u308F\u3063\u305F\u3068\u3044\u3046\u30E1\u30FC\u30EB"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u53D6\u5F15\u5148\u304B\u3089\u300C\u632F\u8FBC\u5148\u306E\u53E3\u5EA7\u304C\u5909\u308F\u308A\u307E\u3057\u305F\u300D\u3068\u30E1\u30FC\u30EB\u304C\u6765\u307E\u3057\u305F\u3002\u4ECA\u65E5\u4E2D\u306B\u6255\u3046\u3088\u3046\u6025\u304B\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u30E1\u30FC\u30EB\u306B\u8FD4\u4FE1\u3057\u3066\u78BA\u8A8D\u3067\u304D\u305F\u3089\u3001\u5909\u66F4\u3057\u3066\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u524D\u304B\u3089\u77E5\u3063\u3066\u3044\u308B\u53D6\u5F15\u5148\u306E\u96FB\u8A71\u756A\u53F7\u306B\u304B\u3051\u3066\u78BA\u304B\u3081\u3066\u304F\u3060\u3055\u3044\u3002\u30E1\u30FC\u30EB\u3067\u306F\u78BA\u304B\u3081\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u30E1\u30FC\u30EB\u306B\u8FD4\u4FE1\u3057\u3066\u78BA\u8A8D\u3067\u304D\u308C\u3070\u5909\u66F4\u3057\u3066\u5927\u4E08\u592B\u3067\u3059\u3002"
  replyAfterAnswer: "\u96FB\u8A71\u3067\u78BA\u8A8D\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u53D6\u5F15\u5148\u306B\u306A\u308A\u3059\u307E\u3057\u3066\u507D\u306E\u632F\u8FBC\u5148\u3092\u4F1D\u3048\u308B\u624B\u53E3\uFF08\u30D3\u30B8\u30CD\u30B9\u30E1\u30FC\u30EB\u8A50\u6B3A\uFF09\u3002\u30E1\u30FC\u30EB\u4EE5\u5916\u306E\u3001\u524D\u304B\u3089\u77E5\u3063\u3066\u3044\u308B\u9023\u7D61\u5148\u3067\u78BA\u304B\u3081\u308B\u3002"
  sourceNote: "\u4EE4\u548C\u5143\u5E74\u5EA6 \u79CB\u671F \u60C5\u5831\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u30DE\u30CD\u30B8\u30E1\u30F3\u30C8\u8A66\u9A13
    \u5348\u524D \u554F1\uFF08\u6539\u5909\uFF09"
