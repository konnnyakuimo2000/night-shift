  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u53E4\u3044PC\u3092\u6368\u3066\u308B\u524D\u306B\u3001\u30CF\u30FC\u30C9\u30C7\u30A3\u30B9\u30AF\u3092\u53D6\u308A\u51FA\u3057\u3066\u58CA\u3057\u3066\u304B\u3089\u51E6\u5206\u3057\u3066\u3044\u3044\u3067\u3059\u304B\uFF1F"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u4E2D\u306E\u60C5\u5831\u304C\u8AAD\u3081\u306A\u3044\u3088\u3046\u306B\u3057\u3066\u304B\u3089\u6368\u3066\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u3044\u3044\u3048\u3002\u30D5\u30A1\u30A4\u30EB\u3092\u6D88\u3057\u3066\u3042\u308B\u306E\u3067\u3001\u305D\u306E\u307E\u307E\u6368\u3066\u3066\u5927\u4E08\u592B\u3067\u3059\u3002"
  replyAfterAnswer: "\u58CA\u3057\u3066\u304B\u3089\u51FA\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
