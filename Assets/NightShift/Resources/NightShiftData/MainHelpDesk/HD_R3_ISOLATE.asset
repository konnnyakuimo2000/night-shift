  successReply: "\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u304B\u3089\u5207\u308A\u96E2\u3057\u305F\u3093\u3067\u3059\u306D\u3002\u89E6\u3089\u305A\u306B\u5F85\u3061\u307E\u3059\u3002"
  failureReply: "\u307E\u3060\u30CD\u30C3\u30C8\u306B\u3064\u306A\u304C\u3063\u305F\u307E\u307E\u307F\u305F\u3044\u3067\u3059\u2026\u3002"
