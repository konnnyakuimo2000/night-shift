  subject: "\u9000\u8077\u8005\u306EID\u3092\u6B8B\u3057\u3066\u304A\u304D\u305F\u3044"
  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u6765\u6708\u9000\u8077\u3059\u308B\u90E8\u4E0B\u306EID\u306F\u3001\u5F15\u304D\u7D99\u304E\u306E\u305F\u3081\u306B\u9000\u8077\u5F8C\u3082\u3057\u3070\u3089\u304F\u6B8B\u3057\u3066\u304A\u3044\u3066\u307B\u3057\u3044\u306E\u3067\u3059\u304C\u3002"
  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002ID\u306F\u9000\u8077\u3068\u540C\u6642\u306B\u7121\u52B9\u306B\u3057\u307E\u3059\u3002\u5F15\u304D\u7D99\u304E\u306F\u5225\u306E\u65B9\u6CD5\u3067\u884C\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u5F15\u304D\u7D99\u304E\u306E\u305F\u3081\u3001\u9000\u8077\u5F8C\u3082\u6B8B\u3057\u3066\u304A\u304D\u307E\u3059\u3002"
  replyAfterAnswer: "\u308F\u304B\u308A\u307E\u3057\u305F\u3001\u4EBA\u4E8B\u3068\u8ABF\u6574\u3057\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u4E0D\u8981\u306B\u306A\u3063\u305FID\u306F\u76F4\u3061\u306B\u7121\u52B9\u306B\u3059\u308B\u3002\u6B8B\u3057\u3066\u304A\u304F\u3068\u9000\u8077\u8005\u306B\u3088\u308B\u4E0D\u6B63\u30A2\u30AF\u30BB\u30B9\u306B\u3064\u306A\u304C\u308B\u3002\u9000\u8077\u9593\u969B\u306F\u3080\u3057\u308D\u76E3\u8996\u3092\u5F37\u3081\u308B\u3002"
  sourceNote: "\u5E73\u621030\u5E74\u5EA6 \u6625\u671F \u60C5\u5831\u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u30DE\u30CD\u30B8\u30E1\u30F3\u30C8\u8A66\u9A13
