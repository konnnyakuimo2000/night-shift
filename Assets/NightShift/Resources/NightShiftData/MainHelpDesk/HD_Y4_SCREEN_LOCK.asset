  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u306F\u3044\u3002\u96E2\u5E2D\u4E2D\u306B\u306E\u305E\u304B\u308C\u305F\u308A\u64CD\u4F5C\u3055\u308C\u305F\u308A\u3059\u308B\u306E\u3092\u9632\u3052\u307E\u3059\u3002"
  incorrectOption: "\u3044\u3044\u3048\u3002\u793E\u5185\u306A\u306E\u3067\u30ED\u30C3\u30AF\u306F\u4E0D\u8981\u3067\u3059\u3002"
  replyAfterAnswer: "\u8A2D\u5B9A\u3057\u3066\u304A\u304D\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u96E2\u5E2D\u6642\u306B\u753B\u9762\u3092\u30ED\u30C3\u30AF\u3059\u308B\uFF08\u30AF\u30EA\u30A2\u30B9\u30AF\u30EA\u30FC\u30F3\uFF09\u3002"
  sourceNote: "\u4EE4\u548C5\u5E74\u5EA6 IT\u30D1\u30B9\u30DD\u30FC\u30C8\u8A66\u9A13
