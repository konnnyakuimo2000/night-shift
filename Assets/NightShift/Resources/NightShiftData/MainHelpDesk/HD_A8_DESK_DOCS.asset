  message: "{dept}\u306E{name}\u3067\u3059\u3002\n\u591C\u52E4\u660E\u3051\u3001\u9867\u5BA2\u30EA\u30B9\u30C8\u3092\u673A\u306B\u7F6E\u3044\u305F\u307E\u307E\u5E30\u3063\u3066\u3082\u3044\u3044\u3067\u3059\u304B\uFF1F
