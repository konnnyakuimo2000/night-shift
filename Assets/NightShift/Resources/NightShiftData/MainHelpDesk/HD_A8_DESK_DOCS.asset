  reminderMessage: "\u3059\u307F\u307E\u305B\u3093\u3001\u5148\u307B\u3069\u306E\u4EF6\u3001\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304B\u2026\uFF1F"
  reminderAfterMinutes: 25
  correctOption: "\u3044\u3044\u3048\u3002\u66F8\u985E\u306F\u7247\u4ED8\u3051\u3066\u3001\u9375\u306E\u304B\u304B\u308B\u5F15\u304D\u51FA\u3057\u306A\u3069\u306B\u3057\u307E\u3063\u3066\u304F\u3060\u3055\u3044\u3002"
  incorrectOption: "\u306F\u3044\u3002\u793E\u5185\u306A\u3089\u673A\u306B\u7F6E\u3044\u305F\u307E\u307E\u3067\u5927\u4E08\u592B\u3067\u3059\u3002"
  replyAfterAnswer: "\u3057\u307E\u3063\u3066\u5E30\u308A\u307E\u3059\u3002"
  pcProfile: {fileID: 0}
  faultVariants: []
  resolutionConditions: []
  successReply: "\u76F4\u308A\u307E\u3057\u305F\uFF01\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
  failureReply: "\u3059\u307F\u307E\u305B\u3093\u3001\u307E\u3060\u76F4\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u3067\u3059\u2026"
  maxReports: 2
  explanation: "\u96E2\u5E2D\u3084\u5E30\u5B85\u306E\u3068\u304D\u306B\u66F8\u985E\u3092\u673A\u306B\u51FA\u3057\u305F\u307E\u307E\u306B\u3057\u306A\u3044\uFF08\u30AF\u30EA\u30A2\u30C7\u30B9\u30AF\uFF09\u3002\u76D7\u96E3\u3084\u306E\u305E\u304D\u898B\u3092\u9632\u3050\u3002"
  sourceNote: "\u4EE4\u548C5\u5E74\u5EA6 IT\u30D1\u30B9\u30DD\u30FC\u30C8\u8A66\u9A13
